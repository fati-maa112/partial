<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    'use strict';

    /* ── Scroll reveal ── */
    const allReveal = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');
    const revealIO  = new IntersectionObserver((entries) => {
        entries.forEach(e => {
            if (e.isIntersecting) { e.target.classList.add('in-view'); revealIO.unobserve(e.target); }
        });
    }, { threshold: 0.10, rootMargin: '0px 0px -50px 0px' });
    allReveal.forEach(el => revealIO.observe(el));

    /* ── Navbar scroll ── */
    const nav = document.getElementById('mainNav');
    window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 80);
    }, { passive: true });

    /* ── Qty stepper (shared helper) ── */
    window.changeQty = function (btn, delta) {
        const wrap = btn.closest('.qty-stepper');
        const val  = wrap.querySelector('.qty-val');
        let n = parseInt(val.textContent) + delta;
        if (n < 1) n = 1;
        val.textContent = n;
    };

    /* ── Search overlay ── */
    const SEARCH_INDEX = [
        { title: 'Velvet Veil Moisturiser',  sub: 'Featured Product · ₱1,250.00',  tag: 'Product',   icon: '🧴', anchor: '/shop',          keywords: 'moisturiser face veil velvet cream' },
        { title: 'Nuage Facial Mist',        sub: 'Featured Product · ₱980.00',    tag: 'Product',   icon: '💧', anchor: '/shop',          keywords: 'mist facial spray nuage face' },
        { title: 'Rosée Repair Serum',       sub: 'Featured Product · ₱650.00',    tag: 'Product',   icon: '✨', anchor: '/shop',          keywords: 'serum repair rosee vitamin c' },
        { title: 'Pure Cleanse Gel',         sub: 'Updates · Face Care',           tag: 'Article',   icon: '🌿', anchor: '/#updates',     keywords: 'cleanse gel face wash morning' },
        { title: 'Dew Hydration Cream',      sub: 'Updates · Bestseller',          tag: 'Article',   icon: '💦', anchor: '/#updates',     keywords: 'hydration cream dew face moisturiser' },
        { title: 'Glow C Serum',             sub: 'Updates · Wellness',            tag: 'Article',   icon: '☀️', anchor: '/#updates',     keywords: 'glow serum vitamin c radiance wellness' },
        { title: 'Calm Essence Toner',       sub: 'Updates · Body',                tag: 'Article',   icon: '🍃', anchor: '/#updates',     keywords: 'toner calm essence body antioxidant' },
        { title: 'Shop Products',            sub: 'Page',                          tag: 'Page',      icon: '🛍️', anchor: '/shop',          keywords: 'shop buy products' },
        { title: 'About Us',                 sub: 'Page',                          tag: 'Page',      icon: '🌱', anchor: '/about',         keywords: 'about story brand mission' },
        { title: 'Contact',                  sub: 'Page',                          tag: 'Page',      icon: '✉️', anchor: '/contact',       keywords: 'contact email reach out' },
        { title: 'Customer Reviews',         sub: 'Landing Page Section',          tag: 'Section',   icon: '⭐', anchor: '/#testimonials', keywords: 'reviews testimonials ratings' },
    ];

    const overlay     = document.getElementById('searchOverlay');
    const searchInput = document.getElementById('searchInput');
    const searchClose = document.getElementById('searchClose');
    const resultsEl   = document.getElementById('searchResults');
    const emptyEl     = document.getElementById('searchEmpty');
    const emptyTerm   = document.getElementById('searchEmptyTerm');
    const labelEl     = document.getElementById('searchLabel');
    const catsEl      = document.getElementById('searchCategories');
    let focusIdx = -1;

    function openSearch() {
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
        setTimeout(() => searchInput.focus(), 80);
        renderDefault();
    }
    function closeSearch() {
        overlay.classList.remove('active');
        document.body.style.overflow = '';
        searchInput.value = '';
        focusIdx = -1;
    }
    function highlight(text, query) {
        if (!query) return text;
        const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return text.replace(new RegExp('(' + escaped + ')', 'gi'), '<mark>$1</mark>');
    }
    function renderResults(items, query) {
        resultsEl.innerHTML = '';
        emptyEl.style.display = 'none';
        catsEl.style.display  = 'none';
        if (items.length === 0) {
            emptyTerm.textContent = query;
            emptyEl.style.display = 'block';
            labelEl.textContent   = '';
            return;
        }
        labelEl.textContent = query ? items.length + ' result' + (items.length !== 1 ? 's' : '') : 'Popular searches';
        items.forEach((item) => {
            const a = document.createElement('a');
            a.className = 'search-result-item';
            a.href = item.anchor;
            a.innerHTML = `<div class="sri-icon">${item.icon}</div><div class="sri-text"><div class="sri-title">${highlight(item.title, query)}</div><div class="sri-sub">${item.sub}</div></div><span class="sri-tag">${item.tag}</span>`;
            a.addEventListener('click', () => closeSearch());
            resultsEl.appendChild(a);
        });
    }
    function renderDefault() {
        catsEl.style.display = 'flex';
        resultsEl.innerHTML  = '';
        emptyEl.style.display = 'none';
        labelEl.textContent  = 'Popular searches';
    }
    function doSearch(q) {
        const query = q.trim().toLowerCase();
        if (!query) { renderDefault(); return; }
        const results = SEARCH_INDEX.filter(item =>
            item.title.toLowerCase().includes(query) ||
            item.keywords.toLowerCase().includes(query) ||
            item.tag.toLowerCase().includes(query)
        );
        renderResults(results, q.trim());
    }
    function updateFocus(delta) {
        const items = resultsEl.querySelectorAll('.search-result-item');
        if (!items.length) return;
        items[focusIdx]?.classList.remove('focused');
        focusIdx = (focusIdx + delta + items.length) % items.length;
        items[focusIdx].classList.add('focused');
        items[focusIdx].scrollIntoView({ block: 'nearest' });
    }

    document.getElementById('searchOpenBtn').addEventListener('click', openSearch);
    searchClose.addEventListener('click', closeSearch);
    searchInput.addEventListener('input', (e) => { focusIdx = -1; doSearch(e.target.value); });
    searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown')  { e.preventDefault(); updateFocus(1); }
        if (e.key === 'ArrowUp')    { e.preventDefault(); updateFocus(-1); }
        if (e.key === 'Enter') { resultsEl.querySelector('.search-result-item.focused')?.click(); }
        if (e.key === 'Escape') closeSearch();
    });
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeSearch(); });
    document.querySelectorAll('.search-cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            searchInput.value = btn.dataset.query;
            doSearch(btn.dataset.query);
            searchInput.focus();
        });
    });
    document.addEventListener('keydown', (e) => {
        if (overlay.classList.contains('active')) return;
        if ((e.key === '/' && document.activeElement.tagName !== 'INPUT') || (e.ctrlKey && e.key === 'k')) {
            e.preventDefault(); openSearch();
        }
    });

})();
</script>

{% block extra_scripts %}{% endblock %}

</body>
</html>

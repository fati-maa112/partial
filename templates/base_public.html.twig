<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}Naturaé Skincare — Pure. Natural. Radiant.{% endblock %}">
    <title>{% block title %}Naturaé Skincare — Pure. Natural. Radiant.{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=Playfair+Display:ital,wght@1,400;1,500&display=swap" rel="stylesheet">

    <style>
        :root {
            --cream:        #faf7f0;
            --cream-mid:    #f2ebe0;
            --cream-deep:   #e8dfd0;
            --taupe:        #b79b7f;
            --taupe-light:  #d4c3ae;
            --taupe-faint:  rgba(183,155,127,0.10);
            --sage:         #7a8661;
            --sage-light:   #9ba882;
            --sage-dark:    #5f6b4d;
            --sage-faint:   #eef0e9;
            --sage-ultra:   #f4f6f0;
            --moss:         #4a5240;
            --text:         #2a2520;
            --text-mid:     #524c44;
            --text-muted:   #8a7f72;
            --white:        #ffffff;

            --shadow-xs:   0 1px 6px rgba(60,52,40,0.05);
            --shadow-sm:   0 2px 16px rgba(60,52,40,0.07);
            --shadow-md:   0 6px 32px rgba(60,52,40,0.10);
            --shadow-lg:   0 16px 56px rgba(60,52,40,0.13);
            --shadow-xl:   0 28px 80px rgba(60,52,40,0.17);

            --r-sm:   10px;
            --r-md:   18px;
            --r-lg:   28px;
            --r-xl:   40px;
            --r-pill: 100px;

            --ease: cubic-bezier(0.22, 1, 0.36, 1);
            --t:    all 0.4s var(--ease);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; font-size: 16px; }

        body {
            background-color: var(--cream);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            font-weight: 300;
            line-height: 1.85;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5 {
            font-family: 'Cormorant Garamond', Georgia, serif;
            line-height: 1.1; color: var(--text);
        }
        p { color: var(--text-mid); }
        a { text-decoration: none; }

        /* ── SEARCH OVERLAY ── */
        #searchOverlay {
            position: fixed; inset: 0; z-index: 9999;
            background: rgba(250,247,240,0.97);
            backdrop-filter: blur(32px);
            -webkit-backdrop-filter: blur(32px);
            display: flex; flex-direction: column; align-items: center;
            opacity: 0; pointer-events: none;
            transition: opacity 0.35s var(--ease);
        }
        #searchOverlay.active { opacity: 1; pointer-events: all; }
        .search-overlay-inner {
            width: 100%; max-width: 780px;
            padding: 120px 2rem 3rem;
            display: flex; flex-direction: column; gap: 2.5rem;
        }
        .search-bar-wrap {
            display: flex; align-items: center; gap: 1rem;
            border-bottom: 2px solid rgba(122,134,97,0.30);
            padding-bottom: 1rem; transition: border-color 0.25s;
        }
        .search-bar-wrap:focus-within { border-color: var(--sage-dark); }
        .search-bar-icon { font-size: 1.4rem; color: var(--sage-dark); flex-shrink: 0; }
        #searchInput {
            flex: 1; border: none; background: transparent; outline: none;
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(1.6rem, 4vw, 2.4rem);
            font-weight: 300; color: var(--text); letter-spacing: -0.01em;
        }
        #searchInput::placeholder { color: rgba(42,37,32,0.25); }
        .search-close-btn {
            width: 44px; height: 44px; border-radius: 50%;
            border: 1.5px solid rgba(122,134,97,0.28);
            background: transparent; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            color: var(--text-muted); font-size: 1.1rem;
            flex-shrink: 0; transition: var(--t);
        }
        .search-close-btn:hover { background: var(--sage-dark); color: var(--white); border-color: var(--sage-dark); }
        .search-hint { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); display: flex; gap: 1.5rem; flex-wrap: wrap; }
        .search-hint span { display: flex; align-items: center; gap: 0.4rem; }
        .search-hint kbd { background: rgba(122,134,97,0.10); border: 1px solid rgba(122,134,97,0.22); border-radius: 5px; padding: 2px 8px; font-family: 'DM Sans', sans-serif; font-size: 0.68rem; color: var(--sage-dark); }
        .search-results { display: flex; flex-direction: column; gap: 0.5rem; max-height: 55vh; overflow-y: auto; }
        .search-results::-webkit-scrollbar { width: 4px; }
        .search-results::-webkit-scrollbar-track { background: transparent; }
        .search-results::-webkit-scrollbar-thumb { background: rgba(122,134,97,0.30); border-radius: 4px; }
        .search-result-item { display: flex; align-items: center; gap: 1.2rem; padding: 0.9rem 1.2rem; border-radius: var(--r-md); cursor: pointer; transition: background 0.2s; border: 1px solid transparent; text-decoration: none; }
        .search-result-item:hover, .search-result-item.focused { background: var(--sage-faint); border-color: rgba(122,134,97,0.15); }
        .sri-icon { width: 44px; height: 44px; border-radius: var(--r-sm); background: var(--cream-mid); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; border: 1px solid rgba(183,155,127,0.18); }
        .sri-text { flex: 1; }
        .sri-title { font-family: 'DM Sans', sans-serif; font-size: 0.92rem; font-weight: 400; color: var(--text); line-height: 1.3; }
        .sri-title mark { background: rgba(122,134,97,0.20); color: var(--sage-dark); border-radius: 2px; padding: 0 2px; }
        .sri-sub { font-size: 0.75rem; color: var(--text-muted); font-weight: 300; }
        .sri-tag { font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sage-dark); background: rgba(122,134,97,0.10); border-radius: var(--r-pill); padding: 3px 10px; flex-shrink: 0; border: 1px solid rgba(122,134,97,0.15); }
        .search-empty { text-align: center; padding: 3rem 1rem; font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-style: italic; color: var(--text-muted); display: none; }
        .search-categories { display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .search-cat-btn { font-family: 'DM Sans', sans-serif; font-size: 0.78rem; letter-spacing: 0.06em; padding: 0.4rem 1.1rem; border-radius: var(--r-pill); border: 1.5px solid rgba(183,155,127,0.25); cursor: pointer; transition: var(--t); background: transparent; color: var(--text-muted); }
        .search-cat-btn:hover { background: var(--sage-faint); color: var(--sage-dark); border-color: rgba(122,134,97,0.35); }
        .search-section-label { font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); padding: 0 1.2rem; margin-top: 0.5rem; }

        /* ── NAVBAR ── */
        .n-nav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            padding: 1.4rem 0; background: transparent; transition: var(--t);
        }
        .n-nav.scrolled {
            padding: 0.75rem 0;
            background: rgba(250,247,240,0.96);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            box-shadow: 0 2px 28px rgba(60,52,40,0.08);
            border-bottom: 1px solid rgba(183,155,127,0.14);
        }
        .nav-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
        .nav-left  { display: flex; align-items: center; }
        .nav-right { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; }
        .n-nav .container { max-width: 100%; padding-left: 3rem; padding-right: 3rem; }

        .brand-logo-center { display: inline-flex; align-items: center; justify-content: center; text-decoration: none; transition: opacity 0.25s; }
        .brand-logo-center:hover { opacity: 0.80; }
        .brand-logo-center img { height: 68px; width: auto; object-fit: contain; filter: brightness(0) invert(1) drop-shadow(0 2px 12px rgba(0,0,0,0.25)); transition: filter 0.4s var(--ease), height 0.3s var(--ease); }
        .n-nav.scrolled .brand-logo-center img { filter: none; height: 54px; }

        .n-link { font-size: 0.95rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.95); padding: 0.55rem 1.3rem; text-decoration: none; position: relative; transition: color 0.25s; white-space: nowrap; }
        .n-link::after { content: ''; position: absolute; bottom: 0; left: 1.3rem; right: 1.3rem; height: 1.5px; background: rgba(255,255,255,0.80); transform: scaleX(0); transform-origin: left; transition: transform 0.3s var(--ease); }
        .n-link:hover { color: var(--white); }
        .n-link:hover::after { transform: scaleX(1); }
        .n-nav.scrolled .n-link { color: var(--text-mid); font-weight: 500; }
        .n-nav.scrolled .n-link:hover { color: var(--sage-dark); }
        .n-nav.scrolled .n-link::after { background: var(--sage-dark); }

        {# ── If the page has a light/non-hero background, force dark nav from the start ── #}
        .n-nav.nav-dark { background: rgba(250,247,240,0.96); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border-bottom: 1px solid rgba(183,155,127,0.14); padding: 0.75rem 0; }
        .n-nav.nav-dark .brand-logo-center img { filter: none; height: 54px; }
        .n-nav.nav-dark .n-link { color: var(--text-mid); }
        .n-nav.nav-dark .n-link:hover { color: var(--sage-dark); }
        .n-nav.nav-dark .n-link::after { background: var(--sage-dark); }
        .n-nav.nav-dark .nav-icon-btn { background: var(--sage-faint); border-color: rgba(122,134,97,0.20); color: var(--sage-dark); }
        .n-nav.nav-dark .nav-icon-btn:hover { background: var(--sage-dark); border-color: var(--sage-dark); color: var(--white); box-shadow: 0 6px 20px rgba(95,107,77,0.30); }
        .n-nav.nav-dark .nav-flag { color: var(--text-muted); border-color: rgba(122,134,97,0.22); background: var(--sage-faint); }
        .n-nav.nav-dark .nav-toggler { color: var(--text); }

        .nav-icon-wrap { position: relative; display: inline-flex; }
        .nav-icon-wrap::after { content: attr(data-tip); position: absolute; bottom: -2.1rem; left: 50%; transform: translateX(-50%) translateY(4px); background: rgba(30,25,20,0.85); color: rgba(255,255,255,0.90); font-family: 'DM Sans', sans-serif; font-size: 0.58rem; font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.2rem 0.55rem; border-radius: 4px; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 0.18s, transform 0.18s; backdrop-filter: blur(4px); }
        .nav-icon-wrap:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }
        .nav-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.18); border-radius: 50%; color: var(--white); font-size: 0.95rem; text-decoration: none; transition: var(--t); backdrop-filter: blur(8px); cursor: pointer; }
        .nav-icon-btn:hover { background: rgba(255,255,255,0.24); border-color: rgba(255,255,255,0.40); color: var(--white); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.15); }
        .n-nav.scrolled .nav-icon-btn { background: var(--sage-faint); border-color: rgba(122,134,97,0.20); color: var(--sage-dark); }
        .n-nav.scrolled .nav-icon-btn:hover { background: var(--sage-dark); border-color: var(--sage-dark); color: var(--white); box-shadow: 0 6px 20px rgba(95,107,77,0.30); }

        .nav-flag { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.72rem; font-weight: 400; letter-spacing: 0.08em; color: rgba(255,255,255,0.80); padding: 0.3rem 0.85rem; border: 1px solid rgba(255,255,255,0.22); border-radius: var(--r-pill); backdrop-filter: blur(8px); background: rgba(255,255,255,0.10); transition: var(--t); white-space: nowrap; cursor: default; }
        .nav-flag:hover { background: rgba(255,255,255,0.20); color: var(--white); border-color: rgba(255,255,255,0.42); }
        .n-nav.scrolled .nav-flag { color: var(--text-muted); border-color: rgba(122,134,97,0.22); background: var(--sage-faint); }
        .nav-flag .flag-img { width: 22px; height: 15px; object-fit: cover; border-radius: 3px; display: block; box-shadow: 0 1px 4px rgba(0,0,0,0.18); }

        .nav-toggler { background: transparent; border: none; cursor: pointer; color: var(--white); font-size: 1.5rem; display: none; }
        .n-nav.scrolled .nav-toggler { color: var(--text); }

        /* ── SHARED SECTION HELPERS ── */
        .eyebrow { font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--sage); font-weight: 400; margin-bottom: 0.8rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
        .eyebrow-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--sage); display: inline-block; }
        .section-title { font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 300; letter-spacing: -0.015em; line-height: 1.08; margin-bottom: 1rem; }
        .section-title em { font-family: 'Playfair Display', serif; font-style: italic; color: var(--sage); font-weight: 400; }
        .section-sub { font-size: 1rem; color: var(--text-muted); max-width: 520px; line-height: 1.85; font-weight: 300; }
        .btn-shop-all { display: inline-flex; align-items: center; gap: 0.5rem; border: 1.5px solid rgba(122,134,97,0.35); border-radius: var(--r-pill); background: transparent; color: var(--sage-dark); padding: 0.55rem 1.5rem; font-family: 'DM Sans', sans-serif; font-size: 0.74rem; font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; transition: var(--t); }
        .btn-shop-all:hover { background: var(--sage-dark); color: var(--white); border-color: var(--sage-dark); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
        .btn-spotlight-primary { display: inline-flex; align-items: center; gap: 0.55rem; background: var(--sage-dark); color: var(--white); border: none; border-radius: 100px; padding: 1rem 2.4rem; font-family: 'DM Sans', sans-serif; font-size: 0.76rem; font-weight: 400; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; text-decoration: none; transition: var(--t); box-shadow: 0 8px 28px rgba(95,107,77,0.28); }
        .btn-spotlight-primary:hover { background: var(--moss); transform: translateY(-3px); box-shadow: 0 16px 40px rgba(74,82,64,0.32); color: var(--white); }

        /* ── SCROLL REVEAL ── */
        .reveal, .reveal-left, .reveal-right { opacity: 0; transition: opacity 0.8s var(--ease), transform 0.8s var(--ease); }
        .reveal       { transform: translateY(28px); }
        .reveal-left  { transform: translateX(-36px); }
        .reveal-right { transform: translateX(36px); }
        .reveal.in-view, .reveal-left.in-view, .reveal-right.in-view { opacity: 1; transform: none; }
        .d1 { transition-delay: 0.05s; }
        .d2 { transition-delay: 0.15s; }
        .d3 { transition-delay: 0.25s; }
        .d4 { transition-delay: 0.35s; }

        /* ── FOOTER ENHANCED ── */
#footer { padding: 0; background: #2e3828; position: relative; overflow: hidden; }

.footer-botanical {
    position: absolute; right: -30px; bottom: 80px;
    opacity: 0.04; pointer-events: none; z-index: 0;
}

/* Newsletter bar */
.footer-newsletter {
    background: #232e1e;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 2rem 0;
}
.fn-inner {
    display: flex; align-items: center;
    justify-content: space-between; gap: 2rem; flex-wrap: wrap;
}
.fn-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem; font-weight: 300;
    color: #fff; line-height: 1.2; margin: 0 0 0.25rem;
}
.fn-sub {
    font-size: 0.78rem; color: rgba(255,255,255,0.35);
    margin: 0; letter-spacing: 0.05em;
}
.fn-form {
    display: flex; min-width: 300px; max-width: 420px; flex: 1;
}
.fn-form input {
    flex: 1; padding: 0.72rem 1.2rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12); border-right: none;
    border-radius: 100px 0 0 100px;
    color: #fff; font-family: 'DM Sans', sans-serif; font-size: 0.82rem;
    outline: none; transition: border-color 0.25s;
}
.fn-form input::placeholder { color: rgba(255,255,255,0.25); }
.fn-form input:focus { border-color: rgba(155,168,130,0.5); }
.fn-form button {
    padding: 0.72rem 1.5rem; background: var(--sage);
    border: none; border-radius: 0 100px 100px 0;
    color: #fff; font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
    cursor: pointer; transition: background 0.25s; white-space: nowrap;
}
.fn-form button:hover { background: var(--sage-dark); }

/* Main footer body */
.footer-main { padding: 4rem 0 2.5rem; position: relative; }

/* Logo & brand */
.footer-logo img { height: 38px; width: auto; opacity: 0.82; }
.footer-tagline {
    font-size: 0.64rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(255,255,255,0.28); margin: 0.6rem 0 1.2rem;
    display: flex; align-items: center; gap: 0.6rem;
}
.footer-tagline::before, .footer-tagline::after {
    content: ''; flex: 1; height: 1px; background: rgba(255,255,255,0.09);
}
.footer-desc {
    font-size: 0.82rem; color: rgba(255,255,255,0.36);
    max-width: 230px; line-height: 1.8; margin-bottom: 1.5rem;
}

/* Certification badges */
.footer-badges { display: flex; flex-direction: column; gap: 0.5rem; }
.footer-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.68rem; letter-spacing: 0.10em; text-transform: uppercase;
    color: rgba(155,168,130,0.75);
    border: 1px solid rgba(155,168,130,0.18); border-radius: 100px;
    padding: 0.3rem 0.85rem; width: fit-content;
}
.fb-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--sage-light); display: inline-block; }

/* Column heading */
.footer-col-title {
    font-size: 0.64rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(255,255,255,0.28); margin-bottom: 0.9rem; font-weight: 500;
}
.footer-col-accent {
    width: 28px; height: 2px;
    background: linear-gradient(90deg, var(--sage), transparent);
    margin-bottom: 1.3rem;
}

/* Links */
.f-link {
    display: flex; align-items: center; gap: 0;
    font-size: 0.82rem; color: rgba(255,255,255,0.40);
    text-decoration: none; padding: 0.28rem 0;
    transition: color 0.2s, gap 0.25s; letter-spacing: 0.03em;
    position: relative;
}
.f-link::before {
    content: ''; width: 0; height: 1px;
    background: var(--sage-light); transition: width 0.25s;
    display: inline-block; margin-right: 0; flex-shrink: 0;
}
.f-link:hover { color: rgba(255,255,255,0.88); gap: 0.5rem; }
.f-link:hover::before { width: 10px; }

/* Contact */
.footer-contact-row { display: flex; align-items: flex-start; gap: 0.7rem; margin-bottom: 0.9rem; }
.fc-icon {
    width: 30px; height: 30px; border-radius: 8px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.09);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.82rem; color: rgba(155,168,130,0.65); flex-shrink: 0;
}
.fc-text {
    font-size: 0.80rem; color: rgba(255,255,255,0.40); line-height: 1.55;
}
.fc-text strong {
    display: block; font-size: 0.62rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: rgba(255,255,255,0.22);
    font-weight: 400; margin-bottom: 1px;
}

/* Certif pills */
.footer-certifs { display: flex; gap: 0.45rem; margin-top: 1.2rem; flex-wrap: wrap; }
.footer-certif {
    font-size: 0.60rem; letter-spacing: 0.10em;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px; padding: 0.28rem 0.65rem;
    color: rgba(255,255,255,0.26);
}

/* Social icons */
.footer-social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.09); border-radius: 50%;
    color: rgba(255,255,255,0.38); font-size: 0.90rem;
    text-decoration: none; transition: var(--t);
}
.footer-social a:hover {
    background: rgba(155,168,130,0.16);
    border-color: rgba(155,168,130,0.38); color: var(--sage-light);
    transform: translateY(-3px);
}

/* Bottom bar */
.footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.07);
    padding: 1.5rem 0;
    background: rgba(0,0,0,0.10);
}
.footer-copy { font-size: 0.73rem; color: rgba(255,255,255,0.22); }
.footer-copy a { color: rgba(255,255,255,0.28); text-decoration: none; transition: color 0.2s; }
.footer-copy a:hover { color: rgba(255,255,255,0.70); }
.f-dot { color: rgba(183,155,127,0.5); margin: 0 0.6rem; }

        /* ── RESPONSIVE ── */
        @media (max-width: 992px) {
            .nav-inner { grid-template-columns: auto 1fr auto; }

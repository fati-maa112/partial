{% block extra_scripts %}
<script>
(function () {
    'use strict';

    /* ══ Scroll Reveal ══ */
    const io = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } });
    }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
    document.querySelectorAll('.reveal,.reveal-left,.reveal-right').forEach(el => io.observe(el));

    /* ══ Qty Stepper ══ */
    window.changeQty = function (btn, delta) {
        const val = btn.parentElement.querySelector('.qty-val');
        let n = parseInt(val.textContent) + delta;
        val.textContent = Math.max(1, Math.min(99, n));
    };

    /* ══ Cart State ══ */
    let cart = [];
    const FREE_SHIP_THRESHOLD = 1500;

    function formatPrice(p) {
        return '₱' + p.toLocaleString('en-PH', { minimumFractionDigits: 2 });
    }
    function getCartTotal() { return cart.reduce((s, i) => s + i.price * i.qty, 0); }
    function saveCart() { try { localStorage.setItem('naturae_cart', JSON.stringify(cart)); } catch(e) {} }
    function loadCart() { try { const c = localStorage.getItem('naturae_cart'); if (c) cart = JSON.parse(c); } catch(e) {} }

    function updateCartUI() {
        const total = getCartTotal();
        const count = cart.reduce((s, i) => s + i.qty, 0);
        document.getElementById('cartCount').textContent     = count;
        document.getElementById('cartPillBadge').textContent = count;
        document.getElementById('cartPill').classList.toggle('is-visible', count > 0);
        const footer = document.getElementById('cartFooter');
        const emptyEl = document.getElementById('cartEmptyState');
        footer.style.display = cart.length ? '' : 'none';
        emptyEl.style.display = cart.length ? 'none' : '';
        document.getElementById('cartSubtotal').textContent = formatPrice(total);
        const pct = Math.min(100, (total / FREE_SHIP_THRESHOLD) * 100);
        document.getElementById('cartFreeShipFill').style.width = pct + '%';
        const remaining = FREE_SHIP_THRESHOLD - total;
        const shipMsg = document.getElementById('cartFreeShipMsg');
        if (total >= FREE_SHIP_THRESHOLD) {
            shipMsg.innerHTML = '<i class="bi bi-check-circle"></i> &nbsp;You qualify for <strong>free shipping!</strong>';
        } else {
            shipMsg.innerHTML = '<i class="bi bi-truck"></i> &nbsp;Add ' + formatPrice(remaining) + ' more for <strong>free shipping</strong>';
        }
        const list = document.getElementById('cartItemsList');
        const existingEmpty = list.querySelector('.cart-empty');
        list.querySelectorAll('.cart-item').forEach(el => el.remove());
        cart.forEach((item, idx) => {
            const el = document.createElement('div');
            el.className = 'cart-item';
            el.innerHTML = `
                <div class="cart-item-img"><img src="${item.img}" alt="${item.name}"></div>
                <div class="cart-item-body">
                    <span class="cart-item-cat">${item.cat}</span>
                    <div class="cart-item-name">${item.name}</div>
                    <div class="cart-item-qty-row">
                        <button class="ci-qty-btn" onclick="cartChangeQty(${idx},-1)">−</button>
                        <span class="ci-qty-val">${item.qty}</span>
                        <button class="ci-qty-btn" onclick="cartChangeQty(${idx},1)">+</button>
                    </div>
                    <div class="cart-item-row">
                        <span class="cart-item-price">${formatPrice(item.price * item.qty)}</span>
                        <button class="cart-item-remove" onclick="removeFromCart(${idx})">Remove</button>
                    </div>
                </div>`;
            list.insertBefore(el, existingEmpty);
        });
        saveCart();
    }

    window.cartChangeQty = function(idx, delta) {
        if (!cart[idx]) return;
        cart[idx].qty = Math.max(1, cart[idx].qty + delta);
        updateCartUI();
    };
    window.removeFromCart = function(idx) {
        cart.splice(idx, 1);
        updateCartUI();
    };

    /* ══ Add to Cart ══ */
    window.addToCart = function (btn, e) {
        if (e) e.stopPropagation();
        const card = btn.closest('.product-card');
        const name  = card.querySelector('.product-name').textContent;
        const cat   = card.querySelector('.product-category').textContent;
        const img   = card.querySelector('.product-img-wrap img').src;
        const qtyEl = card.querySelector('.qty-val');
        const qty   = qtyEl ? parseInt(qtyEl.textContent) : 1;
        let priceEl = card.querySelector('.product-price-sale') || card.querySelector('.product-price');
        let price = parseFloat(priceEl.textContent.replace(/[^0-9.]/g,''));
        const existing = cart.find(i => i.name === name);
        if (existing) { existing.qty += qty; } else { cart.push({ name, cat, img, price, qty }); }
        const addBtns = card.querySelectorAll('.btn-add-cart');
        addBtns.forEach(b => {
            b.textContent = '✓ Added'; b.classList.add('added');
            setTimeout(() => { b.textContent = 'Add to Cart'; b.classList.remove('added'); }, 1800);
        });
        updateCartUI();
        showToast(name);
    };

    /* ══ Toast ══ */
    let toastTimer;
    function showToast(name) {
        const toast = document.getElementById('addToast');
        document.getElementById('toastProductName').textContent = name;
        toast.classList.add('is-visible');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('is-visible'), 3200);
    }

    /* ══ Cart Drawer ══ */
    function openCart()  { document.getElementById('cartDrawer').classList.add('is-open'); document.getElementById('cartOverlay').classList.add('is-open'); document.body.style.overflow = 'hidden'; }
    function closeCart() { document.getElementById('cartDrawer').classList.remove('is-open'); document.getElementById('cartOverlay').classList.remove('is-open'); document.body.style.overflow = ''; }
    document.getElementById('cartPill').addEventListener('click', openCart);
    document.getElementById('cartClose').addEventListener('click', closeCart);
    document.getElementById('cartOverlay').addEventListener('click', closeCart);
    document.getElementById('continueShopBtn').addEventListener('click', closeCart);

    /* ══ Category Filter ══ */
    const grid  = document.getElementById('productGrid');
    const cards = Array.from(grid.querySelectorAll('.product-card'));
    const empty = document.getElementById('shopEmpty');

    function applyFilters() {
        const cat  = document.querySelector('.cat-tab.active')?.dataset.cat || 'all';
        const sort = document.getElementById('sortSelect').value;
        const minP = parseFloat(document.getElementById('priceMin').value) || 0;
        const maxP = parseFloat(document.getElementById('priceMax').value) || 999999;
        let visible = cards.filter(c => {
            const catOk  = cat === 'all' || c.dataset.cat === cat;
            const priceOk = parseFloat(c.dataset.price) >= minP && parseFloat(c.dataset.price) <= maxP;
            return catOk && priceOk;
        });
        visible.sort((a, b) => {
            if (sort === 'price-asc')  return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
            if (sort === 'price-desc') return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
            if (sort === 'rating')     return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
            if (sort === 'newest')     return new Date(b.dataset.date) - new Date(a.dataset.date);
            return 0;
        });
        grid.classList.add('is-filtering');
        setTimeout(() => {
            cards.forEach(c => { c.style.display = 'none'; c.style.order = ''; });
            visible.forEach((c, i) => { c.style.display = ''; c.style.order = i; });
            empty.classList.toggle('is-visible', visible.length === 0);
            const n = visible.length;
            document.getElementById('resultsCount').innerHTML = 'Showing <strong>' + n + '</strong> products';
            document.getElementById('productsShowing').innerHTML = 'Showing <strong>' + n + '</strong> of <strong>' + cards.length + '</strong> products';
            grid.classList.remove('is-filtering');
        }, 250);
    }

    document.querySelectorAll('.cat-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            applyFilters();
        });
    });
    document.getElementById('sortSelect').addEventListener('change', applyFilters);
    document.getElementById('applyPrice').addEventListener('click', applyFilters);
    document.getElementById('clearPrice').addEventListener('click', () => {
        document.getElementById('priceMin').value = 0;
        document.getElementById('priceMax').value = 5000;
        applyFilters();
    });

    /* ══ View Toggle ══ */
    document.getElementById('viewGrid').addEventListener('click', function() {
        this.classList.add('active'); document.getElementById('viewList').classList.remove('active');
        grid.classList.remove('view-2col', 'view-list');
    });
    document.getElementById('viewList').addEventListener('click', function() {
        this.classList.add('active'); document.getElementById('viewGrid').classList.remove('active');
        grid.classList.add('view-list'); grid.classList.remove('view-2col');
    });

    /* ══ Skin type toggle ══ */
    document.querySelectorAll('.skin-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.skin-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
        });
    });

    /* ══ Wishlist toggle ══ */
    document.querySelectorAll('.product-wishlist').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            this.classList.toggle('is-liked');
            const icon = this.querySelector('i');
            icon.className = this.classList.contains('is-liked') ? 'bi bi-heart-fill' : 'bi bi-heart';
        });
    });

    /* ══ Price range visual fill ══ */
    function updatePriceFill() {
        const max = 5000;
        const lo  = Math.max(0, parseFloat(document.getElementById('priceMin').value) || 0);
        const hi  = Math.min(max, parseFloat(document.getElementById('priceMax').value) || max);
        const fill = document.getElementById('priceRangeFill');
        fill.style.left  = ((lo / max) * 100) + '%';
        fill.style.right = (((max - hi) / max) * 100) + '%';
    }
    document.getElementById('priceMin').addEventListener('input', updatePriceFill);
    document.getElementById('priceMax').addEventListener('input', updatePriceFill);
    updatePriceFill();

    /* ══ Load More ══ */
    document.getElementById('loadMoreBtn').addEventListener('click', function() {
        this.innerHTML = '<span style="opacity:.6;font-size:.68rem;letter-spacing:.18em">All products loaded</span>';
        this.disabled = true; this.style.opacity = '0.5'; this.style.cursor = 'default';
    });

    /* ══════════════════════════════════════════
       SAFETY PROFILE SYSTEM
    ══════════════════════════════════════════ */

    // Ingredient warning database — maps concern key → ingredient details
    const INGREDIENT_INFO = {
        'pregnancy':            {
            'salicylic-acid':   { name: 'Salicylic Acid',    reason: 'High-dose salicylic acid is associated with risks during pregnancy. Consult your OB-GYN before use.', tags: ['Pregnancy Risk'] },
            'retinol':          { name: 'Retinol',            reason: 'Vitamin A derivatives (retinoids/retinol) are strongly advised against during pregnancy due to potential developmental risks.', tags: ['Pregnancy — Avoid'] },
            'ascorbic-acid':    { name: 'Ascorbic Acid (Vit. C)', reason: 'In high concentrations, topical Vitamin C may not be recommended during early pregnancy. Consult your healthcare provider.', tags: ['Pregnancy — Consult'] },
            'niacinamide':      { name: 'Niacinamide',        reason: 'Generally considered safe in low concentrations, but very high concentrations may warrant caution. Consult your doctor.', tags: ['Pregnancy — Low Risk'] },
            'kojic-acid':       { name: 'Kojic Acid',         reason: 'Limited safety data for use during pregnancy. Consult your dermatologist or OB-GYN before use.', tags: ['Pregnancy — Consult'] },
        },
        'sensitive-skin':       {
            'salicylic-acid':   { name: 'Salicylic Acid',    reason: 'A potent exfoliating acid that may cause irritation, redness, or peeling on sensitive skin types.', tags: ['Potential Irritant'] },
            'tea-tree-oil':     { name: 'Tea Tree Oil',       reason: 'While antibacterial, tea tree oil is a known irritant for sensitive skin and may cause contact dermatitis.', tags: ['Known Irritant'] },
            'retinol':          { name: 'Retinol',            reason: 'Retinol commonly causes redness, dryness, and flaking, especially on sensitive or first-time users.', tags: ['Irritant', 'Start Slowly'] },
            'caffeine':         { name: 'Caffeine',           reason: 'May cause mild temporary tingling or irritation on very sensitive skin. Typically well-tolerated.', tags: ['Mild Sensitiser'] },
            'kojic-acid':       { name: 'Kojic Acid',         reason: 'Can cause irritation, contact dermatitis, or increased sun sensitivity on sensitive skin types.', tags: ['Potential Irritant'] },
        },
        'fragrance-sensitive':  {
            'fragrance':        { name: 'Fragrance / Parfum', reason: 'Synthetic fragrance is one of the most common causes of contact allergies and skin reactions.', tags: ['Common Allergen'] },
            'alcohol':          { name: 'Alcohol / Denatured Alcohol', reason: 'Certain forms of alcohol can be drying and sensitising for fragrance-sensitive individuals.', tags: ['Sensitiser'] },
            'lavender-oil':     { name: 'Lavender Essential Oil', reason: 'Natural lavender oil contains linalool and linalyl acetate, common sensitisers in fragrance allergy.', tags: ['Natural Fragrance', 'Allergen'] },
            'rosewater':        { name: 'Rosewater',          reason: 'Derived from Rosa damascena, rosewater may trigger reactions in individuals with floral/fragrance sensitivities.', tags: ['Natural Fragrance'] },
        },
        'alcohol-free':         {
            'alcohol':          { name: 'Alcohol / Denatured Alcohol', reason: 'This product contains alcohol (ethanol or denatured alcohol), which can be drying and may cause irritation.', tags: ['Drying Alcohol'] },
            'witch-hazel':      { name: 'Witch Hazel',        reason: 'Witch hazel is an astringent that naturally contains tannins and may be processed with alcohol. Can be drying with repeated use.', tags: ['Astringent', 'May Contain Alcohol'] },
        },
        'nut-allergy':          {
            'shea-butter':      { name: 'Shea Butter',        reason: 'Shea butter is derived from the shea tree nut. Those with tree nut allergies should exercise caution and consult an allergist.', tags: ['Tree Nut Derivative'] },
            'sweet-almond-oil': { name: 'Sweet Almond Oil',   reason: 'Almond oil is a tree nut oil. People with nut allergies, particularly almond allergy, should avoid this product.', tags: ['Nut Oil — Avoid'] },
        },
        'citrus-allergy':       {
            'vitamin-c':        { name: 'Vitamin C (Citrus Extract)', reason: 'Vitamin C derived from citrus sources may cause reactions in individuals with citrus fruit allergies.', tags: ['Citrus Derivative'] },
            'ascorbic-acid':    { name: 'Ascorbic Acid',      reason: 'Ascorbic acid (synthetic Vitamin C) is generally safe for citrus-allergic individuals, but some may still react. Monitor closely.', tags: ['Citrus-Derived Form'] },
        },
    };

    const CONCERN_LABELS = {
        'pregnancy':           { label: 'Pregnant / Nursing', icon: '🤰' },
        'sensitive-skin':      { label: 'Sensitive Skin',     icon: '🌸' },
        'fragrance-sensitive': { label: 'Fragrance Sensitive', icon: '🌬️' },
        'alcohol-free':        { label: 'Alcohol-Free',       icon: '🚫' },
        'nut-allergy':         { label: 'Nut Allergy',        icon: '🥜' },
        'citrus-allergy':      { label: 'Citrus Allergy',     icon: '🍋' },
    };

    // User safety profile
    let safetyProfile = {
        concerns: [],      // array of concern keys
        customIngredients: []  // array of custom ingredient strings
    };

    function saveProfile() {
        try { localStorage.setItem('naturae_safety', JSON.stringify(safetyProfile)); } catch(e) {}
    }
    function loadProfile() {
        try {
            const s = localStorage.getItem('naturae_safety');
            if (s) safetyProfile = JSON.parse(s);
        } catch(e) {}
    }

    /* ── Check a card for warnings against current profile ── */
    function getCardWarnings(card) {
        const warningsData = card.dataset.warnings ? JSON.parse(card.dataset.warnings) : {};
        const ingredientList = card.dataset.ingredients ? card.dataset.ingredients.split(',').map(s => s.trim()) : [];
        const triggeredWarnings = []; // { concernKey, ingredientKey, info }

        safetyProfile.concerns.forEach(concernKey => {
            const concernIngredients = warningsData[concernKey] || [];
            concernIngredients.forEach(ingredientKey => {
                const info = INGREDIENT_INFO[concernKey]?.[ingredientKey];
                if (info) {
                    triggeredWarnings.push({ concernKey, ingredientKey, info });
                }
            });
        });

        // Custom ingredient matching
        safetyProfile.customIngredients.forEach(customIng => {
            const normalized = customIng.toLowerCase().replace(/[^a-z0-9]/g, '-');
            ingredientList.forEach(cardIng => {
                const normalizedCard = cardIng.toLowerCase().replace(/[^a-z0-9]/g, '-');
                if (normalizedCard.includes(normalized) || normalized.includes(normalizedCard)) {
                    // Check it's not already flagged
                    const alreadyFlagged = triggeredWarnings.some(w => w.ingredientKey === cardIng);
                    if (!alreadyFlagged) {
                        triggeredWarnings.push({
                            concernKey: 'custom',
                            ingredientKey: cardIng,
                            info: {
                                name: cardIng.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
                                reason: 'This ingredient matches your personal avoid list.',
                                tags: ['Personal Avoid List']
                            }
                        });
                    }
                }
            });
        });

        return triggeredWarnings;
    }

    /* ── Apply warning badges to all visible cards ── */
    function applyWarningBadges() {
        const hasProfile = safetyProfile.concerns.length > 0 || safetyProfile.customIngredients.length > 0;
        cards.forEach(card => {
            const strip = card.querySelector('.product-warning-strip');
            if (!strip) return;

            if (!hasProfile) {
                strip.classList.remove('is-visible');
                card.classList.remove('has-warning');
                return;
            }

            const warnings = getCardWarnings(card);
            if (warnings.length > 0) {
                strip.classList.add('is-visible');
                card.classList.add('has-warning');
                const subEl = strip.querySelector('.warn-strip-sub');
                const count = warnings.length;
                subEl.textContent = count === 1 ? '1 concern found — tap to view' : count + ' concerns found — tap to view';
            } else {
                strip.classList.remove('is-visible');
                card.classList.remove('has-warning');
            }
        });
    }

    /* ── Open Warning Modal ── */
    let warnTargetCard = null;
    window.openWarningModal = function(strip) {
        const card = strip.closest('.product-card');
        warnTargetCard = card;
        const name = card.querySelector('.product-name').textContent;
        const warnings = getCardWarnings(card);

        document.getElementById('warnModalProductName').textContent = name;

        // Profile chips
        const profileRow = document.getElementById('warnModalProfileRow');
        profileRow.innerHTML = '';
        safetyProfile.concerns.forEach(c => {
            const info = CONCERN_LABELS[c];
            if (info) {
                const tag = document.createElement('span');
                tag.className = 'warn-profile-tag';
                tag.innerHTML = `<i class="bi bi-check-circle"></i> ${info.icon} ${info.label}`;
                profileRow.appendChild(tag);
            }
        });
        if (safetyProfile.customIngredients.length > 0) {
            const tag = document.createElement('span');
            tag.className = 'warn-profile-tag';
            tag.innerHTML = `<i class="bi bi-list-check"></i> ${safetyProfile.customIngredients.length} custom avoid${safetyProfile.customIngredients.length > 1 ? 's' : ''}`;
            profileRow.appendChild(tag);
        }

        // Warning items
        const list = document.getElementById('warnItemsList');
        list.innerHTML = '';
        warnings.forEach(w => {
            const item = document.createElement('div');
            item.className = 'warn-item';
            const tagsHtml = w.info.tags.map(t => `<span class="warn-item-tag">${t}</span>`).join('');
            item.innerHTML = `
                <div class="warn-item-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div class="warn-item-body">
                    <div class="warn-item-ingredient">${w.info.name}</div>
                    <div class="warn-item-reason">${w.info.reason}</div>
                    <div class="warn-item-tags">${tagsHtml}</div>
                </div>`;
            list.appendChild(item);
        });

        // Safe note — check for non-triggered ingredients
        const allProductIngredients = card.dataset.ingredients ? card.dataset.ingredients.split(',') : [];
        const triggeredIngredients = warnings.map(w => w.ingredientKey);
        const safeCount = allProductIngredients.filter(i => !triggeredIngredients.includes(i.trim())).length;
        const safeNote = document.getElementById('warnSafeNote');
        const safeNoteText = document.getElementById('warnSafeNoteText');
        if (safeCount > 0 && allProductIngredients.length > 0) {
            safeNote.style.display = 'flex';
            safeNoteText.innerHTML = `<strong>${safeCount} of ${allProductIngredients.length} key ingredients</strong> in this product do not conflict with your safety profile.`;
        } else {
            safeNote.style.display = 'none';
        }

        document.getElementById('warnModalOverlay').classList.add('is-open');
        document.body.style.overflow = 'hidden';
    };

    function closeWarnModal() {
        document.getElementById('warnModalOverlay').classList.remove('is-open');
        document.body.style.overflow = '';
        warnTargetCard = null;
    }

    document.getElementById('warnModalClose').addEventListener('click', closeWarnModal);
    document.getElementById('btnWarnClose').addEventListener('click', closeWarnModal);
    document.getElementById('warnModalOverlay').addEventListener('click', function(e) {
        if (e.target === this) closeWarnModal();
    });
    document.getElementById('btnWarnAddAnyway').addEventListener('click', function() {
        if (warnTargetCard) {
            const addBtn = warnTargetCard.querySelector('.btn-add-cart');
            if (addBtn) addToCart(addBtn, null);
        }
        closeWarnModal();
    });

    /* ── Profile Modal ── */
    function openProfileModal() {
        // Sync UI with current profile
        document.querySelectorAll('.concern-btn').forEach(btn => {
            const concern = btn.dataset.concern;
            const isActive = safetyProfile.concerns.includes(concern);
            btn.classList.toggle('active', isActive);
            btn.querySelector('.cb-check i').style.display = isActive ? 'block' : 'none';
        });
        document.getElementById('customAllergyInput').value = safetyProfile.customIngredients.join(', ');
        // Sync preset tags
        document.querySelectorAll('.allergy-preset-tag').forEach(tag => {
            const preset = tag.dataset.preset;
            tag.classList.toggle('active-tag', safetyProfile.customIngredients.includes(preset));
        });
        document.getElementById('profileModalOverlay').classList.add('is-open');
        document.body.style.overflow = 'hidden';
    }

    function closeProfileModal() {
        document.getElementById('profileModalOverlay').classList.remove('is-open');
        document.body.style.overflow = '';
    }

    document.getElementById('openProfileModal').addEventListener('click', openProfileModal);
    document.getElementById('profileModalClose').addEventListener('click', closeProfileModal);
    document.getElementById('profileCancelBtn').addEventListener('click', closeProfileModal);
    document.getElementById('profileModalOverlay').addEventListener('click', function(e) {
        if (e.target === this) closeProfileModal();
    });

    // Concern button toggles
    document.querySelectorAll('.concern-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            this.classList.toggle('active');
            this.querySelector('.cb-check i').style.display = this.classList.contains('active') ? 'block' : 'none';
        });
    });

    // Preset allergy tags
    document.querySelectorAll('.allergy-preset-tag').forEach(tag => {
        tag.addEventListener('click', function() {
            const preset = this.dataset.preset;
            const input = document.getElementById('customAllergyInput');
            const current = input.value.split(',').map(s => s.trim()).filter(Boolean);
            if (this.classList.contains('active-tag')) {
                const idx = current.indexOf(preset);
                if (idx > -1) current.splice(idx, 1);
                this.classList.remove('active-tag');
            } else {
                if (!current.includes(preset)) current.push(preset);
                this.classList.add('active-tag');
            }
            input.value = current.join(', ');
        });
    });

    // Save profile
    document.getElementById('profileSaveBtn').addEventListener('click', function() {
        const activeConcerns = [];
        document.querySelectorAll('.concern-btn.active').forEach(btn => {
            activeConcerns.push(btn.dataset.concern);
        });
        const customVal = document.getElementById('customAllergyInput').value;
        const customIngredients = customVal.split(',').map(s => s.trim().toLowerCase().replace(/\s+/g, '-')).filter(Boolean);

        safetyProfile.concerns = activeConcerns;
        safetyProfile.customIngredients = customIngredients;
        saveProfile();
        updateSafetyBannerChips();
        applyWarningBadges();
        closeProfileModal();
    });

    /* ── Safety Banner Chips ── */
    function updateSafetyBannerChips() {
        const chipsEl = document.getElementById('safetyChips');
        chipsEl.innerHTML = '';
        const allActive = [...safetyProfile.concerns, ...(safetyProfile.customIngredients.length > 0 ? ['__custom__'] : [])];
        if (allActive.length === 0) return;
        allActive.slice(0, 3).forEach(key => {
            const chip = document.createElement('span');
            chip.className = 'safety-chip active-warn';
            if (key === '__custom__') {
                chip.innerHTML = `<span class="chip-dot"></span>${safetyProfile.customIngredients.length} custom`;
            } else {
                const info = CONCERN_LABELS[key];
                chip.innerHTML = `<span class="chip-dot"></span>${info ? info.icon + ' ' + info.label : key}`;
            }
            chipsEl.appendChild(chip);
        });
        if (allActive.length > 3) {
            const more = document.createElement('span');
            more.className = 'safety-chip';
            more.innerHTML = `<span class="chip-dot"></span>+${allActive.length - 3} more`;
            chipsEl.appendChild(more);
        }
    }

    /* ══ Init ══ */
    loadCart();
    updateCartUI();
    loadProfile();
    updateSafetyBannerChips();
    applyWarningBadges();

})();
</script>
{% endblock %}

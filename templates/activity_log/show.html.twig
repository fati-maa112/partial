{% extends 'base.html.twig' %}

{% block title %}Activity Log Details - Naturae Admin{% endblock %}
{% block page_title %}Activity Log Details{% endblock %}

{% block stylesheets %}
<style>
    .detail-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .detail-card {
        background: var(--color-white);
        border-radius: 16px;
        padding: 35px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        margin-bottom: 20px;
    }

    [data-theme="dark"] .detail-card {
        background: var(--color-white);
    }

    .detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        padding-bottom: 25px;
        border-bottom: 2px solid rgba(122, 134, 97, 0.1);
        flex-wrap: wrap;
        gap: 20px;
    }

    .detail-title {
        font-size: 28px;
        font-weight: 700;
        color: var(--color-olive);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .detail-title i {
        font-size: 32px;
        color: var(--color-sand);
    }

    .detail-id {
        font-size: 18px;
        font-weight: 600;
        color: #999;
        background: var(--color-cream);
        padding: 8px 16px;
        border-radius: 10px;
    }

    [data-theme="dark"] .detail-id {
        background: #2f2f2f;
    }

    .action-header {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 12px 24px;
        border-radius: 12px;
        font-size: 18px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 25px;
    }

    .action-header.create {
        background: rgba(76, 175, 80, 0.1);
        color: #4caf50;
        border: 2px solid #4caf50;
    }

    .action-header.update {
        background: rgba(33, 150, 243, 0.1);
        color: #2196f3;
        border: 2px solid #2196f3;
    }

    .action-header.delete {
        background: rgba(244, 67, 54, 0.1);
        color: #f44336;
        border: 2px solid #f44336;
    }

    .action-header.login {
        background: rgba(156, 39, 176, 0.1);
        color: #9c27b0;
        border: 2px solid #9c27b0;
    }

    .action-header.logout {
        background: rgba(255, 152, 0, 0.1);
        color: #ff9800;
        border: 2px solid #ff9800;
    }

    .detail-section {
        margin-bottom: 30px;
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--color-olive);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title i {
        font-size: 20px;
        color: var(--color-sand);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .info-item {
        background: var(--color-cream);
        border-radius: 12px;
        padding: 20px;
        border: 2px solid rgba(122, 134, 97, 0.1);
        transition: all 0.3s ease;
    }

    [data-theme="dark"] .info-item {
        background: #2f2f2f;
        border-color: rgba(155, 168, 130, 0.2);
    }

    .info-item:hover {
        border-color: var(--color-olive-light);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(122, 134, 97, 0.15);
    }

    .info-label {
        font-size: 12px;
        font-weight: 700;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .info-label i {
        font-size: 14px;
        color: var(--color-olive);
    }

    .info-value {
        font-size: 16px;
        font-weight: 600;
        color: var(--color-text);
        word-break: break-word;
    }

    .description-box {
        background: var(--color-cream);
        border-radius: 12px;
        padding: 25px;
        border: 2px solid rgba(122, 134, 97, 0.1);
        margin-top: 15px;
    }

    [data-theme="dark"] .description-box {
        background: #2f2f2f;
        border-color: rgba(155, 168, 130, 0.2);
    }

    .description-text {
        font-size: 15px;
        line-height: 1.7;
        color: var(--color-text);
        margin: 0;
    }

    .role-badge {
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        background: linear-gradient(135deg, var(--color-olive) 0%, var(--color-olive-light) 100%);
        color: white;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .timestamp-box {
        background: linear-gradient(135deg, var(--color-cream) 0%, rgba(245, 242, 234, 0.5) 100%);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        border: 2px solid rgba(122, 134, 97, 0.1);
    }

    [data-theme="dark"] .timestamp-box {
        background: linear-gradient(135deg, #2f2f2f 0%, rgba(47, 47, 47, 0.5) 100%);
        border-color: rgba(155, 168, 130, 0.2);
    }

    .timestamp-icon {
        width: 50px;
        height: 50px;
        background: var(--color-olive);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
        flex-shrink: 0;
    }

    .timestamp-info {
        flex: 1;
    }

    .timestamp-label {
        font-size: 12px;
        font-weight: 700;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .timestamp-value {
        font-size: 18px;
        font-weight: 600;
        color: var(--color-text);
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        background: linear-gradient(135deg, var(--color-olive) 0%, var(--color-olive-light) 100%);
        color: white;
        border-radius: 12px;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(122, 134, 97, 0.2);
    }

    .back-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(122, 134, 97, 0.3);
    }

    .back-btn i {
        font-size: 16px;
    }

    .readonly-notice {
        background: linear-gradient(135deg, rgba(255, 152, 0, 0.1) 0%, rgba(255, 193, 7, 0.05) 100%);
        border: 2px solid #ff9800;
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
    }

    .readonly-notice i {
        font-size: 24px;
        color: #ff9800;
    }

    .readonly-notice p {
        margin: 0;
        font-size: 14px;
        font-weight: 600;
        color: var(--color-text);
    }

    @media (max-width: 768px) {
        .detail-card {
            padding: 25px;
        }

        .detail-header {
            flex-direction: column;
        }

        .detail-title {
            font-size: 24px;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="detail-container">
    <div class="detail-card">
        <div class="detail-header">
            <div class="detail-title">
                <i class="fas fa-file-alt"></i>
                Log Entry
            </div>
            <div class="detail-id">ID: #{{ log.id }}</div>
        </div>

        <div class="action-header {{ log.action|lower }}">
            {% if log.action == 'CREATE' %}
                <i class="fas fa-plus-circle"></i>
            {% elseif log.action == 'UPDATE' %}
                <i class="fas fa-edit"></i>
            {% elseif log.action == 'DELETE' %}
                <i class="fas fa-trash-alt"></i>
            {% elseif log.action == 'LOGIN' %}
                <i class="fas fa-sign-in-alt"></i>
            {% elseif log.action == 'LOGOUT' %}
                <i class="fas fa-sign-out-alt"></i>
            {% endif %}
            {{ log.action }} Action
        </div>

        <div class="detail-section">
            <div class="section-title">
                <i class="fas fa-user"></i>
                User Information
            </div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-user-circle"></i>
                        Username
                    </div>
                    <div class="info-value">{{ log.username }}</div>
                </div>

                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-shield-alt"></i>
                        Role
                    </div>
                    <div class="info-value">
                        <span class="role-badge">
                            <i class="fas fa-check-circle"></i>
                            {{ log.role }}
                        </span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-network-wired"></i>
                        IP Address
                    </div>
                    <div class="info-value">{{ log.ipAddress ?? 'N/A' }}</div>
                </div>
            </div>
        </div>

        <div class="detail-section">
            <div class="section-title">
                <i class="fas fa-info-circle"></i>
                Action Details
            </div>
            <div class="description-box">
                <p class="description-text">{{ log.targetData }}</p>
            </div>
        </div>

        <div class="detail-section">
            <div class="section-title">
                <i class="fas fa-clock"></i>
                Timestamp
            </div>
            <div class="timestamp-box">
                <div class="timestamp-icon">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div class="timestamp-info">
                    <div class="timestamp-label">Performed At</div>
                    <div class="timestamp-value">
                        {{ log.createdAt|date('F d, Y') }} at {{ log.createdAt|date('h:i:s A') }}
                    </div>
                </div>
            </div>
        </div>

        <div class="readonly-notice">
            <i class="fas fa-lock"></i>
            <p>Activity logs are read-only and cannot be modified to maintain system integrity.</p>
        </div>

        <div style="margin-top: 30px;">
            <a href="{{ path('app_activity_logs') }}" class="back-btn">
                <i class="fas fa-arrow-left"></i>
                Back to Activity Logs
            </a>
        </div>
    </div>
</div>
{% endblock %}
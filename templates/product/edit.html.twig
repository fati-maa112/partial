{% extends 'base.html.twig' %}

{% block title %}Edit Product - {{ product.name }}{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e8ebe9 100%);
        font-family: 'Poppins', sans-serif;
        color: #333;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .page-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    /* Header Section */
    .page-header {
        background: linear-gradient(135deg, #C2B280 0%, #a9986c 100%);
        padding: 30px 40px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(194, 178, 128, 0.3);
        text-align: center;
    }

    .page-header h1 {
        color: #fff;
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 8px 0;
        letter-spacing: -0.5px;
    }

    .page-header p {
        color: rgba(255, 255, 255, 0.9);
        font-size: 15px;
        margin: 0;
    }

    .page-header .product-id {
        display: inline-block;
        margin-top: 8px;
        padding: 6px 16px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        backdrop-filter: blur(10px);
    }

    /* Form Container */
    .form-container {
        background: #fff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    /* Current Image Display */
    .current-image-section {
        background: linear-gradient(135deg, #f9fafb, #ffffff);
        border: 2px solid #e5e7eb;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 32px;
        text-align: center;
    }

    .current-image-section h3 {
        font-size: 14px;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .current-image-section h3 i {
        color: #C2B280;
    }

    .image-preview-wrapper {
        position: relative;
        display: inline-block;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }

    .image-preview-wrapper img {
        max-width: 300px;
        width: 100%;
        height: auto;
        display: block;
        border: 4px solid #fff;
    }

    .image-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(194, 178, 128, 0.95);
        color: #fff;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        backdrop-filter: blur(10px);
    }

    /* Form Groups */
    .form-row {
        margin-bottom: 24px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .form-grid-full {
        grid-column: 1 / -1;
    }

    label {
        display: block;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #374151;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    label.required:after {
        content: " *";
        color: #ef4444;
    }

    /* Input Styles */
    input[type="text"],
    input[type="number"],
    textarea,
    select {
        width: 100%;
        padding: 14px 16px;
        border-radius: 12px;
        border: 2px solid #e5e7eb;
        background: #f9fafb;
        font-size: 15px;
        transition: all 0.3s ease;
        font-family: 'Poppins', sans-serif;
    }

    input[type="text"]:focus,
    input[type="number"]:focus,
    textarea:focus,
    select:focus {
        border-color: #C2B280;
        outline: none;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(194, 178, 128, 0.1);
    }

    textarea {
        resize: vertical;
        min-height: 120px;
    }

    /* File Upload Section */
    .file-upload-section {
        background: #fef3c7;
        border: 2px solid #fbbf24;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .file-upload-section h3 {
        font-size: 14px;
        font-weight: 700;
        color: #78350f;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .file-upload-section h3 i {
        color: #f59e0b;
    }

    .file-upload-wrapper {
        position: relative;
    }

    .file-upload-label {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        border: 3px dashed #fbbf24;
        border-radius: 12px;
        background: #fffbeb;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
    }

    .file-upload-label:hover {
        border-color: #f59e0b;
        background: #fff;
    }

    .file-upload-label i {
        font-size: 48px;
        color: #f59e0b;
        margin-bottom: 12px;
    }

    .file-upload-text {
        display: block;
    }

    .file-upload-text strong {
        color: #92400e;
        font-weight: 700;
    }

    .file-upload-text small {
        display: block;
        color: #78350f;
        font-size: 13px;
        margin-top: 4px;
    }

    input[type="file"] {
        position: absolute;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }

    /* Selected File Name */
    .file-name {
        display: none;
        margin-top: 12px;
        padding: 12px 16px;
        background: #d1fae5;
        border: 2px solid #10b981;
        border-radius: 10px;
        color: #065f46;
        font-size: 14px;
        font-weight: 600;
    }

    .file-name i {
        margin-right: 8px;
    }

    /* Info Box */
    .info-box {
        background: linear-gradient(135deg, #dbeafe, #e0f2fe);
        border: 2px solid #60a5fa;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .info-box i {
        color: #2563eb;
        font-size: 20px;
        margin-top: 2px;
    }

    .info-box-content {
        flex: 1;
    }

    .info-box-content strong {
        display: block;
        color: #1e40af;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .info-box-content p {
        color: #1e3a8a;
        font-size: 13px;
        margin: 0;
        line-height: 1.5;
    }

    /* Buttons */
    .form-actions {
        display: flex;
        gap: 16px;
        margin-top: 32px;
    }

    .btn {
        flex: 1;
        padding: 16px 24px;
        border-radius: 12px;
        border: none;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #C2B280, #a9986c);
        color: #fff;
        box-shadow: 0 4px 12px rgba(194, 178, 128, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(194, 178, 128, 0.4);
    }

    .btn-secondary {
        background: #fff;
        color: #C2B280;
        border: 2px solid #e5e7eb;
    }

    .btn-secondary:hover {
        border-color: #C2B280;
        background: #f9fafb;
        transform: translateY(-2px);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-container {
            padding: 24px;
        }

        .page-header {
            padding: 24px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn {
            width: 100%;
        }

        .current-image-section img {
            max-width: 100%;
        }
    }
</style>

<div class="page-wrapper">
    <!-- Header Section -->
    <div class="page-header">
        <h1><i class="fas fa-edit"></i> Edit Product</h1>
        <p>Update product information</p>
        <span class="product-id">Product ID: #{{ product.id }}</span>
    </div>

    <!-- Info Box -->
    <div class="info-box">
        <i class="fas fa-info-circle"></i>
        <div class="info-box-content">
            <strong>Editing: {{ product.name }}</strong>
            <p>Modify any fields below and click "Update Product" to save your changes. Leave the image field empty to keep the current image.</p>
        </div>
    </div>

    <!-- Form Container -->
    <div class="form-container">
        <!-- Current Image Display -->
        {% if product.image %}
        <div class="current-image-section">
            <h3>
                <i class="fas fa-image"></i>
                Current Product Image
            </h3>
            <div class="image-preview-wrapper">
                <img src="{{ asset('images/' ~ product.image) }}" alt="{{ product.name }}">
                <span class="image-badge">
                    <i class="fas fa-check-circle"></i> Current
                </span>
            </div>
        </div>
        {% endif %}

        {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data', 'id': 'product-form' } }) }}

        <div class="form-grid">
            <!-- Product Name -->
            <div class="form-row form-grid-full">
                {{ form_label(form.name) }}
                {{ form_widget(form.name, { 'attr': { 'placeholder': 'e.g., Organic Honey 500g' } }) }}
                {{ form_errors(form.name) }}
            </div>

            <!-- Quantity -->
            <div class="form-row">
                {{ form_label(form.quantity) }}
                {{ form_widget(form.quantity, { 'attr': { 'placeholder': '0', 'min': '0' } }) }}
                {{ form_errors(form.quantity) }}
            </div>

            <!-- Price -->
            <div class="form-row">
                {{ form_label(form.price) }}
                {{ form_widget(form.price, { 'attr': { 'placeholder': '0.00', 'step': '0.01' } }) }}
                {{ form_errors(form.price) }}
            </div>

            <!-- Category -->
            <div class="form-row form-grid-full">
                {{ form_label(form.category) }}
                {{ form_widget(form.category) }}
                {{ form_errors(form.category) }}
            </div>

            <!-- Description -->
            <div class="form-row form-grid-full">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, { 'attr': { 'placeholder': 'Describe your product in detail...', 'rows': '5' } }) }}
                {{ form_errors(form.description) }}
            </div>
        </div>

        <!-- Image Upload Section -->
        <div class="file-upload-section">
            <h3>
                <i class="fas fa-sync-alt"></i>
                Replace Product Image (Optional)
            </h3>
            <div class="file-upload-wrapper">
                {{ form_widget(form.image, { 
                    'attr': { 
                        'id': 'file-input',
                        'accept': 'image/*'
                    } 
                }) }}
                <label for="file-input" class="file-upload-label">
                    <div>
                        <i class="fas fa-cloud-upload-alt"></i>
                        <div class="file-upload-text">
                            <strong>Click to upload a new image</strong> or drag and drop
                            <small>PNG, JPG, JPEG (MAX. 5MB) - Leave empty to keep current image</small>
                        </div>
                    </div>
                </label>
                <div class="file-name" id="file-name">
                    <i class="fas fa-check-circle"></i>
                    <span id="file-name-text"></span>
                </div>
            </div>
            {{ form_errors(form.image) }}
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
            <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Update Product
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
// File upload preview
document.getElementById('file-input').addEventListener('change', function(e) {
    const fileName = e.target.files[0]?.name;
    const fileNameDisplay = document.getElementById('file-name');
    const fileNameText = document.getElementById('file-name-text');
    
    if (fileName) {
        fileNameText.textContent = fileName;
        fileNameDisplay.style.display = 'block';
    } else {
        fileNameDisplay.style.display = 'none';
    }
});

// Drag and drop visual feedback
const fileLabel = document.querySelector('.file-upload-label');

['dragenter', 'dragover'].forEach(eventName => {
    fileLabel.addEventListener(eventName, (e) => {
        e.preventDefault();
        fileLabel.style.borderColor = '#f59e0b';
        fileLabel.style.background = '#fff';
    });
});

['dragleave', 'drop'].forEach(eventName => {
    fileLabel.addEventListener(eventName, (e) => {
        e.preventDefault();
        fileLabel.style.borderColor = '#fbbf24';
        fileLabel.style.background = '#fffbeb';
    });
});
</script>
{% endblock %}

{% extends 'base_login.html.twig' %}

{% block title %}Register{% endblock %}

{% block stylesheets %}
  {{ parent() }} 

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
        :root {
            --bg-light: #faf7f0;
            --main-highlight: #b72b7f;
            --secondary-tone: #7a8661;
            --dark-bg: #1f0d1a;
            --card-bg: #2b1123;
            --shadow-dark: rgba(0, 0, 0, 0.4);
            --shadow-light: rgba(255, 255, 255, 0.05);
            --border-radius: 20px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Poppins', sans-serif;
            color: var(--bg-light);
            background: linear-gradient(135deg,
                #170713 0%,
                var(--secondary-tone) 25%,
                #301625 50%,
                var(--main-highlight) 75%,
                var(--dark-bg) 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            position: relative;
            text-shadow: 0 0 2px rgba(0, 0, 0, 0.5);
            padding: 30px 16px;
            overflow-x: hidden;
        }

        .shape-3 {
            position: absolute;
            width: 200px; height: 200px;
            top: 70%; left: 30%;
            opacity: 0.15;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
            pointer-events: none;
            background: radial-gradient(circle, var(--secondary-tone), transparent 70%);
            animation: floatShape 14s infinite linear alternate;
        }

        .register-wrapper {
            position: relative;
        }

        .register-wrapper::before {
            content: '';
            position: fixed;
            width: 350px; height: 350px;
            top: 5%; left: 10%;
            opacity: 0.15;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
            pointer-events: none;
            background: radial-gradient(circle, var(--secondary-tone), transparent 70%);
            animation: floatShape 18s infinite ease-in-out alternate;
        }

        .register-wrapper::after {
            content: '';
            position: fixed;
            width: 450px; height: 450px;
            bottom: 10%; right: 15%;
            opacity: 0.15;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
            pointer-events: none;
            background: radial-gradient(circle, var(--main-highlight), transparent 70%);
            animation: floatShape 25s infinite ease-in-out alternate-reverse;
        }

        @keyframes floatShape {
            0%   { transform: translate(0, 0); }
            50%  { transform: translate(20px, 30px) rotate(10deg); }
            100% { transform: translate(0, 0); }
        }

        .register-wrapper {
            max-width: 440px;
            width: 90%;
            text-align: center;
            z-index: 10;
        }

        .main-header {
            font-size: 1.8em;
            font-weight: 600;
            color: var(--bg-light);
            margin-bottom: 25px;
        }

        .register-card {
            background-color: var(--card-bg);
            padding: 40px;
            border-radius: var(--border-radius);
            box-shadow:
                10px 10px 30px var(--shadow-dark),
                -10px -10px 30px var(--shadow-light),
                0 0 50px rgba(183, 43, 127, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.05);
            margin-bottom: 30px;
        }

        .card-title {
            font-size: 2em;
            font-weight: 700;
            color: var(--main-highlight);
            margin-bottom: 8px;
        }

        .card-subtitle {
            font-size: 0.85em;
            color: rgba(255, 255, 255, 0.38);
            margin-bottom: 28px;
            font-weight: 300;
            letter-spacing: 0.03em;
        }

        .step-indicator {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 30px;
        }

        .step-dot {
            width: 32px; height: 32px;
            border-radius: 50%;
            background-color: #1a0a15;
            border: 2px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75em;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.3);
            box-shadow: inset 3px 3px 6px var(--shadow-dark);
            flex-shrink: 0;
        }

        .step-dot.active {
            background-color: var(--main-highlight);
            border-color: var(--main-highlight);
            color: var(--bg-light);
            box-shadow: 0 0 12px rgba(183, 43, 127, 0.5);
        }

        .step-line {
            width: 48px;
            height: 2px;
            background: rgba(255, 255, 255, 0.08);
            flex-shrink: 0;
        }

        .form-errors-global {
            background: rgba(183, 43, 127, 0.15);
            border: 1px solid rgba(183, 43, 127, 0.3);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-size: 0.85em;
            color: #f8a8d8;
            text-align: left;
        }

        .field-error {
            font-size: 0.78em;
            color: #f8a8d8;
            text-align: left;
            margin: -12px 0 14px 4px;
            display: block;
        }

        .input-group {
            display: flex;
            align-items: center;
            background-color: #1a0a15;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            box-shadow:
                inset 5px 5px 10px var(--shadow-dark),
                inset -5px -5px 10px rgba(255, 255, 255, 0.03);
            transition: all 0.3s;
        }

        .input-group:focus-within {
            box-shadow:
                inset 5px 5px 10px var(--shadow-dark),
                inset -5px -5px 10px rgba(255, 255, 255, 0.03),
                0 0 10px var(--secondary-tone);
        }

        .input-group i {
            margin-right: 13px;
            color: var(--secondary-tone);
            font-size: 1.1em;
            width: 18px;
            text-align: center;
            flex-shrink: 0;
        }

        .input-group input[type="text"],
        .input-group input[type="email"],
        .input-group input[type="password"] {
            flex: 1;
            border: none;
            outline: none;
            font-size: 1em;
            font-family: 'Poppins', sans-serif;
            background-color: transparent;
            color: var(--bg-light);
            padding: 0;
            width: 100%;
        }

        .input-group input::placeholder {
            color: rgba(255, 255, 255, 0.3);
        }

        .password-strength-wrap {
            margin-top: -12px;
            margin-bottom: 20px;
            padding: 0 4px;
        }

        .strength-bar {
            height: 3px;
            border-radius: 4px;
            background: rgba(255, 255, 255, 0.08);
            overflow: hidden;
            margin-bottom: 5px;
        }

        .strength-fill {
            height: 100%;
            width: 0%;
            border-radius: 4px;
            transition: width 0.4s ease, background-color 0.4s ease;
        }

        .strength-label {
            font-size: 0.72em;
            color: rgba(255, 255, 255, 0.35);
            text-align: left;
            transition: color 0.3s;
        }

        .toggle-pw {
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.3);
            cursor: pointer;
            padding: 0;
            font-size: 1em;
            transition: color 0.3s;
            flex-shrink: 0;
        }

        .toggle-pw:hover { color: var(--main-highlight); }

        .terms-row {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 30px;
            text-align: left;
        }

        .custom-checkbox { position: relative; flex-shrink: 0; margin-top: 2px; }

        .custom-checkbox input[type="checkbox"] {
            opacity: 0;
            width: 0;
            height: 0;
            position: absolute;
        }

        .custom-checkbox .checkmark {
            display: block;
            width: 20px; height: 20px;
            border-radius: 6px;
            background: #1a0a15;
            border: 2px solid rgba(255, 255, 255, 0.12);
            box-shadow: inset 3px 3px 6px var(--shadow-dark);
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }

        .custom-checkbox input:checked + .checkmark {
            background: var(--main-highlight);
            border-color: var(--main-highlight);
            box-shadow: 0 0 8px rgba(183, 43, 127, 0.4);
        }

        .custom-checkbox .checkmark::after {
            content: '';
            position: absolute;
            display: none;
            left: 5px; top: 2px;
            width: 5px; height: 9px;
            border: 2px solid var(--bg-light);
            border-top: none; border-left: none;
            transform: rotate(45deg);
        }

        .custom-checkbox input:checked + .checkmark::after { display: block; }

        .terms-text {
            font-size: 0.85em;
            color: rgba(255, 255, 255, 0.55);
            line-height: 1.5;
        }

        .terms-text a {
            color: var(--main-highlight);
            text-decoration: none;
            transition: all 0.3s;
        }

        .terms-text a:hover {
            color: var(--bg-light);
            text-shadow: 0 0 5px var(--main-highlight);
        }

        .register-button {
            width: 100%;
            padding: 15px;
            background: var(--main-highlight);
            color: var(--bg-light);
            border: none;
            border-radius: 12px;
            font-size: 1.1em;
            font-weight: 600;
            font-family: 'Poppins', sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            cursor: pointer;
            transition: all 0.4s ease;
            box-shadow:
                8px 8px 15px var(--shadow-dark),
                -8px -8px 15px rgba(255, 255, 255, 0.05);
        }

        .register-button:hover {
            box-shadow:
                0 0 20px var(--main-highlight),
                0 0 40px rgba(183, 43, 127, 0.3),
                0 0 80px rgba(183, 43, 127, 0.15);
            transform: translateY(-2px);
        }

        .divider {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 28px 0 0;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(255, 255, 255, 0.08);
        }

        .divider span {
            font-size: 0.78em;
            color: rgba(255, 255, 255, 0.25);
            white-space: nowrap;
            letter-spacing: 0.05em;
        }

        .login-link {
            font-size: 1em;
            color: rgba(255, 255, 255, 0.8);
        }

        .login-link a {
            color: var(--secondary-tone);
            font-weight: 600;
            text-decoration: none;
            transition: color 0.3s, text-shadow 0.3s;
        }

        .login-link a:hover {
            color: var(--main-highlight);
            text-shadow: 0 0 8px var(--main-highlight);
        }

        @media (max-width: 500px) {
            .register-card { padding: 30px 20px; }
            .main-header { font-size: 1.5em; margin-bottom: 20px; }
            .card-title { font-size: 1.7em; }
        }
    </style>
{% endblock %}

{% block body %}

    <div class="shape-3"></div>

    <div class="register-wrapper">

        <h1 class="main-header">Join us today</h1>

        <div class="register-card">

            <h2 class="card-title">Create Account</h2>
            <p class="card-subtitle">Fill in your details to get started</p>

            <div class="step-indicator" aria-hidden="true">
                <div class="step-dot active">1</div>
                <div class="step-line"></div>
                <div class="step-dot">2</div>
                <div class="step-line"></div>
                <div class="step-dot">3</div>
            </div>

            {# Global form errors #}
            {% if registrationForm.vars.errors|length %}
                <div class="form-errors-global">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {{ form_start(registrationForm) }}

                {# --- Username --- #}
                <div class="input-group">
                    <i class="fas fa-user"></i>
                    {{ form_widget(registrationForm.username, {
                        'attr': { 'placeholder': 'Choose a username' }
                    }) }}
                </div>
                {% if registrationForm.username.vars.errors|length %}
                    <span class="field-error">{{ form_errors(registrationForm.username) }}</span>
                {% endif %}

                {# --- Email --- #}
                <div class="input-group">
                    <i class="fas fa-envelope"></i>
                    {{ form_widget(registrationForm.email, {
                        'attr': { 'placeholder': 'Enter your email address' }
                    }) }}
                </div>
                {% if registrationForm.email.vars.errors|length %}
                    <span class="field-error">{{ form_errors(registrationForm.email) }}</span>
                {% endif %}

                {# --- Password --- #}
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    {{ form_widget(registrationForm.plainPassword, {
                        'attr': {
                            'placeholder': 'Create a password',
                            'id': 'reg-password'
                        }
                    }) }}
                    <button type="button" class="toggle-pw" id="togglePw" aria-label="Toggle password visibility">
                        <i class="fas fa-eye" id="eyeIcon"></i>
                    </button>
                </div>

                <div class="password-strength-wrap">
                    <div class="strength-bar">
                        <div class="strength-fill" id="strengthFill"></div>
                    </div>
                    <span class="strength-label" id="strengthLabel">Enter a password</span>
                </div>

                {% if registrationForm.plainPassword.vars.errors|length %}
                    <span class="field-error">{{ form_errors(registrationForm.plainPassword) }}</span>
                {% endif %}

                {# --- agreeTerms --- #}
                <div class="terms-row">
                    <label class="custom-checkbox">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        <span class="checkmark"></span>
                    </label>
                    <span class="terms-text">
                        I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
                    </span>
                </div>
                {% if registrationForm.agreeTerms.vars.errors|length %}
                    <span class="field-error">{{ form_errors(registrationForm.agreeTerms) }}</span>
                {% endif %}

                {# --- Submit --- #}
                <button type="submit" class="register-button">Register</button>

            {{ form_end(registrationForm) }}

            <div class="divider"><span>Already have an account?</span></div>

        </div>

        <p class="login-link">
            Have an account? <a href="{{ path('app_login') }}">Sign in here</a>
        </p>

    </div>

    <script>
        const toggleBtn = document.getElementById('togglePw');
        const eyeIcon   = document.getElementById('eyeIcon');
        const pwField   = document.getElementById('reg-password');

        if (toggleBtn && pwField) {
            toggleBtn.addEventListener('click', () => {
                const isHidden    = pwField.type === 'password';
                pwField.type      = isHidden ? 'text' : 'password';
                eyeIcon.className = isHidden ? 'fas fa-eye-slash' : 'fas fa-eye';
            });
        }

        const fill  = document.getElementById('strengthFill');
        const label = document.getElementById('strengthLabel');

        const levels = [
            { color: '#e74c3c', text: 'Too weak', width: '20%' },
            { color: '#e67e22', text: 'Weak',      width: '40%' },
            { color: '#f1c40f', text: 'Fair',      width: '60%' },
            { color: '#7a8661', text: 'Good',      width: '80%' },
            { color: '#27ae60', text: 'Strong',    width: '100%' },
        ];

        function getStrength(pw) {
            let score = 0;
            if (pw.length >= 8)          score++;
            if (pw.length >= 12)         score++;
            if (/[A-Z]/.test(pw))        score++;
            if (/[0-9]/.test(pw))        score++;
            if (/[^A-Za-z0-9]/.test(pw)) score++;
            return Math.min(score, levels.length - 1);
        }

        if (pwField && fill && label) {
            pwField.addEventListener('input', () => {
                const pw = pwField.value;
                if (!pw) {
                    fill.style.width  = '0%';
                    label.textContent = 'Enter a password';
                    label.style.color = 'rgba(255,255,255,0.35)';
                    return;
                }
                const lvl              = levels[getStrength(pw)];
                fill.style.width           = lvl.width;
                fill.style.backgroundColor = lvl.color;
                label.textContent          = lvl.text;
                label.style.color          = lvl.color;
            });
        }
    </script>

{% endblock %}

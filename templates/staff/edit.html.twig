{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e8ebe9 100%);
        font-family: 'Poppins', sans-serif;
        color: #333;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .page-wrapper {
        max-width: 800px;
        margin: 0 auto;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        color: #6b7280;
    }

    .breadcrumb a {
        color: #6B7755;
        text-decoration: none;
        font-weight: 600;
    }

    .breadcrumb a:hover {
        text-decoration: underline;
    }

    .page-header {
        background: linear-gradient(135deg, #6B7755 0%, #556042 100%);
        padding: 30px 40px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(107, 119, 85, 0.3);
        text-align: center;
        color: #fff;
    }

    .page-header h1 {
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 8px 0;
    }

    .page-header p {
        color: rgba(255, 255, 255, 0.9);
        font-size: 15px;
        margin: 0;
    }

    .form-container {
        background: #fff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    .form-row {
        margin-bottom: 24px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    label {
        display: block;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #374151;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    label.required:after {
        content: " *";
        color: #ef4444;
    }

    input[type="text"],
    input[type="email"],
    select {
        width: 100%;
        padding: 14px 16px;
        border-radius: 12px;
        border: 2px solid #e5e7eb;
        background: #f9fafb;
        font-size: 15px;
        transition: all 0.3s ease;
        font-family: 'Poppins', sans-serif;
    }

    input:focus, select:focus {
        border-color: #6B7755;
        outline: none;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(107, 119, 85, 0.1);
    }

    .form-error {
        color: #ef4444;
        font-size: 13px;
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .role-options {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .role-option {
        display: flex;
        align-items: center;
        padding: 16px;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        background: #f9fafb;
    }

    .role-option:hover {
        border-color: #6B7755;
        background: #fff;
    }

    .role-option input[type="checkbox"] {
        width: 20px;
        height: 20px;
        margin-right: 12px;
        cursor: pointer;
    }

    .role-option label {
        margin: 0;
        cursor: pointer;
        flex: 1;
        text-transform: none;
        font-size: 15px;
    }

    .info-box {
        background: linear-gradient(135deg, #dbeafe, #e0f2fe);
        border: 2px solid #60a5fa;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .info-box i {
        color: #2563eb;
        font-size: 20px;
    }

    .info-box p {
        margin: 0;
        color: #1e3a8a;
        font-size: 14px;
    }

    .form-actions {
        display: flex;
        gap: 16px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 2px solid #e5e7eb;
    }

    .btn {
        flex: 1;
        padding: 16px 24px;
        border-radius: 12px;
        border: none;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6B7755, #556042);
        color: #fff;
        box-shadow: 0 4px 12px rgba(107, 119, 85, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(107, 119, 85, 0.4);
    }

    .btn-secondary {
        background: #fff;
        color: #6B7755;
        border: 2px solid #e5e7eb;
    }

    .btn-secondary:hover {
        border-color: #6B7755;
        background: #f9fafb;
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-container {
            padding: 24px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }
    }
</style>

<div class="page-wrapper">
    <div class="breadcrumb">
        <a href="{{ path('app_staff_index') }}"><i class="fas fa-users"></i> Staff Management</a>
        <i class="fas fa-chevron-right"></i>
        <a href="{{ path('app_staff_show', {id: user.id}) }}">{{ user.fullName }}</a>
        <i class="fas fa-chevron-right"></i>
        <span>Edit</span>
    </div>

    <div class="page-header">
        <h1><i class="fas fa-user-edit"></i> Edit User</h1>
        <p>Update user information and settings</p>
    </div>

    <div class="form-container">
        <div class="info-box">
            <i class="fas fa-info-circle"></i>
            <p>To change the password, use the "Reset Password" option from the user details page.</p>
        </div>

        {{ form_start(form) }}

        <div class="form-grid">
            <div class="form-row">
                {{ form_label(form.firstName) }}
                {{ form_widget(form.firstName) }}
                {{ form_errors(form.firstName) }}
            </div>

            <div class="form-row">
                {{ form_label(form.lastName) }}
                {{ form_widget(form.lastName) }}
                {{ form_errors(form.lastName) }}
            </div>
        </div>

        <div class="form-row">
            {{ form_label(form.email) }}
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-row">
            {{ form_label(form.roles) }}
            <div class="role-options">
                {{ form_widget(form.roles) }}
            </div>
            {{ form_errors(form.roles) }}
        </div>

        <div class="form-row">
            {{ form_label(form.status) }}
            {{ form_widget(form.status) }}
            {{ form_errors(form.status) }}
        </div>

        <div class="form-actions">
            <a href="{{ path('app_staff_show', {id: user.id}) }}" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
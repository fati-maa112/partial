{% extends 'base.html.twig' %}

{% block title %}User Details{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e8ebe9 100%);
        font-family: 'Poppins', sans-serif;
        color: #333;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .page-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        color: #6b7280;
    }

    .breadcrumb a {
        color: #6B7755;
        text-decoration: none;
        font-weight: 600;
    }

    .breadcrumb a:hover {
        text-decoration: underline;
    }

    .page-header {
        background: #fff;
        padding: 32px 40px;
        border-radius: 16px;
        margin-bottom: 24px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .user-avatar-large {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6B7755, #556042);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 32px;
    }

    .user-header-info {
        flex: 1;
    }

    .user-header-info h1 {
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 8px 0;
        color: #1f2937;
    }

    .user-header-info p {
        font-size: 15px;
        color: #6b7280;
        margin: 0;
    }

    .badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
        margin-left: 12px;
    }

    .badge.role-admin { background: linear-gradient(135deg, #fce7f3, #fbcfe8); color: #be185d; }
    .badge.role-staff { background: linear-gradient(135deg, #ddd6fe, #c4b5fd); color: #6b21a8; }
    .badge.role-user { background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1e40af; }
    .badge.status-active { background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #065f46; }
    .badge.status-disabled { background: linear-gradient(135deg, #fee2e2, #fecaca); color: #991b1b; }
    .badge.status-archived { background: linear-gradient(135deg, #e5e7eb, #d1d5db); color: #374151; }

    /* Flash Messages */
    .alert {
        padding: 16px 20px;
        border-radius: 12px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        font-weight: 600;
    }

    .alert-success {
        background: linear-gradient(135deg, #d1fae5, #a7f3d0);
        border: 2px solid #10b981;
        color: #065f46;
    }

    .alert-error {
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        border: 2px solid #ef4444;
        color: #991b1b;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }

    .card {
        background: #fff;
        padding: 32px;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 2px solid #e5e7eb;
    }

    .card-header h2 {
        font-size: 18px;
        font-weight: 700;
        margin: 0;
        color: #1f2937;
    }

    .card-header i {
        color: #6B7755;
        font-size: 20px;
    }

    .info-row {
        display: flex;
        padding: 16px 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        font-size: 13px;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        width: 140px;
        flex-shrink: 0;
    }

    .info-value {
        font-size: 15px;
        color: #1f2937;
        font-weight: 500;
    }

    .action-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .btn {
        padding: 14px 20px;
        border-radius: 12px;
        border: none;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6B7755, #556042);
        color: #fff;
        box-shadow: 0 4px 12px rgba(107, 119, 85, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(107, 119, 85, 0.4);
    }

    .btn-warning {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: #fff;
        box-shadow: 0 4px 12px rgba(251, 191, 36, 0.3);
    }

    .btn-warning:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(251, 191, 36, 0.4);
    }

    .btn-danger {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    .btn-danger:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(239, 68, 68, 0.4);
    }

    .btn-secondary {
        background: #f3f4f6;
        color: #374151;
    }

    .btn-secondary:hover {
        background: #e5e7eb;
    }

    .btn-success {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-success:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
    }

    @media (max-width: 768px) {
        .content-grid {
            grid-template-columns: 1fr;
        }

        .card {
            padding: 24px;
        }

        .info-row {
            flex-direction: column;
            gap: 8px;
        }

        .info-label {
            width: 100%;
        }
    }
</style>

<div class="page-wrapper">
    <div class="breadcrumb">
        <a href="{{ path('app_staff_index') }}"><i class="fas fa-users"></i> Staff Management</a>
        <i class="fas fa-chevron-right"></i>
        <span>User Details</span>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i>
            {{ message }}
        </div>
    {% endfor %}

    <div class="page-header">
        <div class="user-avatar-large">
            {{ user.firstName ? user.firstName|slice(0, 1)|upper : user.email|slice(0, 1)|upper }}
        </div>
        <div class="user-header-info">
            <h1>
                {{ user.fullName }}
                <span class="badge role-{{ user.primaryRole|lower }}">{{ user.primaryRole }}</span>
                <span class="badge status-{{ user.status }}">{{ user.status|capitalize }}</span>
            </h1>
            <p>{{ user.email }}</p>
        </div>
    </div>

    <div class="content-grid">
        <div>
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-info-circle"></i>
                    <h2>User Information</h2>
                </div>

                <div class="info-row">
                    <div class="info-label">First Name</div>
                    <div class="info-value">{{ user.firstName ?? 'Not set' }}</div>
                </div>

                <div class="info-row">
                    <div class="info-label">Last Name</div>
                    <div class="info-value">{{ user.lastName ?? 'Not set' }}</div>
                </div>

                <div class="info-row">
                    <div class="info-label">Email</div>
                    <div class="info-value">{{ user.email }}</div>
                </div>

                <div class="info-row">
                    <div class="info-label">Role</div>
                    <div class="info-value">
                        {% for role in user.roles %}
                            {% if role != 'ROLE_USER' %}
                                <span class="badge role-{{ role|replace({'ROLE_': ''})|lower }}">
                                    {{ role|replace({'ROLE_': ''}) }}
                                </span>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">Status</div>
                    <div class="info-value">
                        <span class="badge status-{{ user.status }}">{{ user.status|capitalize }}</span>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">Created At</div>
                    <div class="info-value">{{ user.createdAt|date('F d, Y - h:i A') }}</div>
                </div>

                {% if user.updatedAt %}
                <div class="info-row">
                    <div class="info-label">Last Updated</div>
                    <div class="info-value">{{ user.updatedAt|date('F d, Y - h:i A') }}</div>
                </div>
                {% endif %}
            </div>
        </div>

        <div>
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-cog"></i>
                    <h2>Actions</h2>
                </div>
                <div class="action-card">
                    <a href="{{ path('app_staff_edit', {id: user.id}) }}" class="btn btn-primary">
                        <i class="fas fa-edit"></i> Edit User
                    </a>

                    <a href="{{ path('app_staff_reset_password', {id: user.id}) }}" class="btn btn-warning">
                        <i class="fas fa-key"></i> Reset Password
                    </a>

                    {% if user.status == 'active' %}
                        <form method="post" action="{{ path('app_staff_disable', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('disable' ~ user.id) }}">
                            <button type="submit" class="btn btn-secondary" style="width: 100%;">
                                <i class="fas fa-ban"></i> Disable Account
                            </button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('app_staff_enable', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('enable' ~ user.id) }}">
                            <button type="submit" class="btn btn-success" style="width: 100%;">
                                <i class="fas fa-check-circle"></i> Enable Account
                            </button>
                        </form>
                    {% endif %}

                    {% if user.status != 'archived' %}
                        <form method="post" action="{{ path('app_staff_archive', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ user.id) }}">
                            <button type="submit" class="btn btn-secondary" style="width: 100%;">
                                <i class="fas fa-archive"></i> Archive Account
                            </button>
                        </form>
                    {% endif %}

                    <hr style="border: none; border-top: 2px solid #e5e7eb; margin: 8px 0;">

                    <form method="post" action="{{ path('app_staff_delete', {id: user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button type="submit" class="btn btn-danger" style="width: 100%;">
                            <i class="fas fa-trash"></i> Delete User
                        </button>
                    </form>

                    <a href="{{ path('app_staff_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Edit Profile{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e8ebe9 100%);
        font-family: 'Poppins', sans-serif;
        color: #333;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .page-wrapper {
        max-width: 700px;
        margin: 0 auto;
    }

    /* Header */
    .page-header {
        background: linear-gradient(135deg, #C2B280 0%, #a9986c 100%);
        padding: 30px 40px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(194, 178, 128, 0.3);
        text-align: center;
        color: #fff;
    }

    .page-header h1 {
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 8px 0;
    }

    .page-header p {
        color: rgba(255, 255, 255, 0.9);
        font-size: 15px;
        margin: 0;
    }

    /* Form Container */
    .form-container {
        background: #fff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    /* User Info Display */
    .user-info-display {
        background: linear-gradient(135deg, #f9fafb, #ffffff);
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .user-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #C2B280, #a9986c);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        text-transform: uppercase;
        box-shadow: 0 4px 12px rgba(194, 178, 128, 0.3);
    }

    .user-info-text h3 {
        margin: 0 0 4px 0;
        font-size: 18px;
        color: #1f2937;
    }

    .user-info-text p {
        margin: 0;
        font-size: 13px;
        color: #6b7280;
    }

    /* Form Groups */
    .form-row {
        margin-bottom: 24px;
    }

    label {
        display: block;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #374151;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    label.required:after {
        content: " *";
        color: #ef4444;
    }

    input[type="text"],
    input[type="email"] {
        width: 100%;
        padding: 14px 16px;
        border-radius: 12px;
        border: 2px solid #e5e7eb;
        background: #f9fafb;
        font-size: 15px;
        transition: all 0.3s ease;
        font-family: 'Poppins', sans-serif;
    }

    input:focus {
        border-color: #C2B280;
        outline: none;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(194, 178, 128, 0.1);
    }

    .form-error {
        color: #ef4444;
        font-size: 13px;
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* Buttons */
    .form-actions {
        display: flex;
        gap: 16px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 2px solid #e5e7eb;
    }

    .btn {
        flex: 1;
        padding: 16px 24px;
        border-radius: 12px;
        border: none;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #C2B280, #a9986c);
        color: #fff;
        box-shadow: 0 4px 12px rgba(194, 178, 128, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(194, 178, 128, 0.4);
    }

    .btn-secondary {
        background: #fff;
        color: #C2B280;
        border: 2px solid #e5e7eb;
    }

    .btn-secondary:hover {
        border-color: #C2B280;
        background: #f9fafb;
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .form-container {
            padding: 24px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }
    }
</style>

<div class="page-wrapper">
    <!-- Header -->
    <div class="page-header">
        <h1><i class="fas fa-user-edit"></i> Edit Profile</h1>
        <p>Update your account information</p>
    </div>

    <!-- Form Container -->
    <div class="form-container">
        <!-- Display Username (Read-only) -->
        <div class="user-info-display">
            <div class="user-avatar">
                {{ user.username|slice(0, 2)|upper }}
            </div>
            <div class="user-info-text">
                <h3>{{ user.username }}</h3>
                <p><i class="fas fa-info-circle"></i> Username cannot be changed</p>
            </div>
        </div>

        {{ form_start(form) }}

        <div class="form-row">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, {'attr': {'placeholder': 'your.email@example.com'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-row">
            {{ form_label(form.firstName) }}
            {{ form_widget(form.firstName, {'attr': {'placeholder': 'Enter your first name'}}) }}
            {{ form_errors(form.firstName) }}
        </div>

        <div class="form-row">
            {{ form_label(form.lastName) }}
            {{ form_widget(form.lastName, {'attr': {'placeholder': 'Enter your last name'}}) }}
            {{ form_errors(form.lastName) }}
        </div>

        <div class="form-actions">
            <a href="{{ path('app_profile') }}" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
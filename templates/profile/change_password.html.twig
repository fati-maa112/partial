{% extends 'base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e8ebe9 100%);
        font-family: 'Poppins', sans-serif;
        color: #333;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .page-wrapper {
        max-width: 700px;
        margin: 0 auto;
    }

    /* Header */
    .page-header {
        background: linear-gradient(135deg, #6B7755 0%, #556042 100%);
        padding: 30px 40px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(107, 119, 85, 0.3);
        text-align: center;
        color: #fff;
    }

    .page-header h1 {
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 8px 0;
    }

    .page-header p {
        color: rgba(255, 255, 255, 0.9);
        font-size: 15px;
        margin: 0;
    }

    /* Flash Messages */
    .alert {
        padding: 16px 20px;
        border-radius: 12px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        font-weight: 600;
    }

    .alert-error {
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        border: 2px solid #ef4444;
        color: #991b1b;
    }

    /* Security Notice */
    .security-notice {
        background: linear-gradient(135deg, #dbeafe, #e0f2fe);
        border: 2px solid #60a5fa;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .security-notice i {
        color: #2563eb;
        font-size: 24px;
        margin-top: 2px;
    }

    .security-notice-content h3 {
        font-size: 16px;
        color: #1e40af;
        margin: 0 0 8px 0;
        font-weight: 700;
    }

    .security-notice-content ul {
        margin: 0;
        padding-left: 20px;
        color: #1e3a8a;
        font-size: 13px;
        line-height: 1.7;
    }

    /* Form Container */
    .form-container {
        background: #fff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    /* Form Groups */
    .form-row {
        margin-bottom: 24px;
    }

    label {
        display: block;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #374151;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    label.required:after {
        content: " *";
        color: #ef4444;
    }

    .password-field-wrapper {
        position: relative;
    }

    input[type="password"] {
        width: 100%;
        padding: 14px 50px 14px 16px;
        border-radius: 12px;
        border: 2px solid #e5e7eb;
        background: #f9fafb;
        font-size: 15px;
        transition: all 0.3s ease;
        font-family: 'Poppins', sans-serif;
    }

    input:focus {
        border-color: #6B7755;
        outline: none;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(107, 119, 85, 0.1);
    }

    .toggle-password {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #9ca3af;
        transition: color 0.3s ease;
    }

    .toggle-password:hover {
        color: #6B7755;
    }

    .form-error {
        color: #ef4444;
        font-size: 13px;
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .password-requirements {
        margin-top: 8px;
        padding: 12px 16px;
        background: #f9fafb;
        border-radius: 8px;
        border-left: 3px solid #6B7755;
    }

    .password-requirements h4 {
        font-size: 12px;
        font-weight: 700;
        color: #6B7755;
        margin: 0 0 8px 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .password-requirements ul {
        margin: 0;
        padding-left: 20px;
        font-size: 13px;
        color: #6b7280;
        line-height: 1.7;
    }

    /* Buttons */
    .form-actions {
        display: flex;
        gap: 16px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 2px solid #e5e7eb;
    }

    .btn {
        flex: 1;
        padding: 16px 24px;
        border-radius: 12px;
        border: none;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6B7755, #556042);
        color: #fff;
        box-shadow: 0 4px 12px rgba(107, 119, 85, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(107, 119, 85, 0.4);
    }

    .btn-secondary {
        background: #fff;
        color: #6B7755;
        border: 2px solid #e5e7eb;
    }

    .btn-secondary:hover {
        border-color: #6B7755;
        background: #f9fafb;
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .form-container {
            padding: 24px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }
    }
</style>

<div class="page-wrapper">
    <!-- Header -->
    <div class="page-header">
        <h1><i class="fas fa-key"></i> Change Password</h1>
        <p>Update your account password</p>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('error') %}
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i>
            {{ message }}
        </div>
    {% endfor %}

    <!-- Security Notice -->
    <div class="security-notice">
        <i class="fas fa-shield-alt"></i>
        <div class="security-notice-content">
            <h3>Security Tips</h3>
            <ul>
                <li>Use a strong, unique password you don't use elsewhere</li>
                <li>Avoid using personal information in your password</li>
                <li>Consider using a password manager</li>
                <li>Change your password regularly</li>
            </ul>
        </div>
    </div>

    <!-- Form Container -->
    <div class="form-container">
        {{ form_start(form) }}

        <div class="form-row">
            {{ form_label(form.currentPassword) }}
            <div class="password-field-wrapper">
                {{ form_widget(form.currentPassword, {'attr': {'id': 'currentPassword'}}) }}
                <i class="fas fa-eye toggle-password" onclick="togglePassword('currentPassword', this)"></i>
            </div>
            {{ form_errors(form.currentPassword) }}
        </div>

        <div class="form-row">
            {{ form_label(form.newPassword.first) }}
            <div class="password-field-wrapper">
                {{ form_widget(form.newPassword.first, {'attr': {'id': 'newPassword'}}) }}
                <i class="fas fa-eye toggle-password" onclick="togglePassword('newPassword', this)"></i>
            </div>
            {{ form_errors(form.newPassword.first) }}
            
            <div class="password-requirements">
                <h4>Password Requirements:</h4>
                <ul>
                    <li>At least 6 characters long</li>
                    <li>Mix of uppercase and lowercase letters (recommended)</li>
                    <li>Include numbers and special characters (recommended)</li>
                </ul>
            </div>
        </div>

        <div class="form-row">
            {{ form_label(form.newPassword.second) }}
            <div class="password-field-wrapper">
                {{ form_widget(form.newPassword.second, {'attr': {'id': 'confirmPassword'}}) }}
                <i class="fas fa-eye toggle-password" onclick="togglePassword('confirmPassword', this)"></i>
            </div>
            {{ form_errors(form.newPassword.second) }}
        </div>

        <div class="form-actions">
            <a href="{{ path('app_profile') }}" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-lock"></i> Change Password
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
function togglePassword(fieldId, icon) {
    const field = document.getElementById(fieldId);
    const type = field.getAttribute('type') === 'password' ? 'text' : 'password';
    field.setAttribute('type', type);
    
    // Toggle icon
    if (type === 'text') {
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
    } else {
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
    }
}
</script>
{% endblock %}
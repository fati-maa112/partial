{% extends 'base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e8ebe9 100%);
        font-family: 'Poppins', sans-serif;
        color: #333;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .profile-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    .page-header {
        background: linear-gradient(135deg, #6B7755 0%, #556042 100%);
        padding: 30px 40px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(107, 119, 85, 0.3);
        text-align: center;
        color: #fff;
    }

    .page-header h1 {
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 8px 0;
    }

    .profile-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .profile-header {
        background: #f9fafb;
        border-bottom: 2px solid #e5e7eb;
        padding: 32px 40px;
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, #C2B280, #a9986c);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        font-weight: 700;
        color: #fff;
        text-transform: uppercase;
    }

    .profile-info h2 {
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 8px 0;
        color: #1f2937;
    }

    .profile-role {
        display: inline-block;
        padding: 6px 16px;
        background: linear-gradient(135deg, #6B7755, #556042);
        color: #fff;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .profile-body {
        padding: 40px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-bottom: 32px;
    }

    .info-item {
        background: #f9fafb;
        padding: 20px;
        border-radius: 12px;
        border: 2px solid #e5e7eb;
    }

    .info-label {
        font-size: 12px;
        color: #6b7280;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .info-value {
        font-size: 16px;
        color: #1f2937;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 16px;
        padding-top: 32px;
        border-top: 2px solid #e5e7eb;
    }

    .btn {
        flex: 1;
        padding: 16px 24px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        text-align: center;
        color: #fff;
    }

    .btn-primary {
        background: linear-gradient(135deg, #C2B280, #a9986c);
    }

    .btn-secondary {
        background: linear-gradient(135deg, #6B7755, #556042);
    }
</style>

<div class="profile-wrapper">

    <!-- Header -->
    <div class="page-header">
        <h1><i class="fas fa-user-circle"></i> My Profile</h1>
        <p>Manage your account information</p>
    </div>

    <!-- PROFILE CARD -->
    <div class="profile-card">

        <!-- PROFILE HEADER -->
        <div class="profile-header">

            <div class="profile-avatar">
                {{ user.username|slice(0, 2)|upper }}
            </div>

            <div class="profile-info">
                <h2>{{ user.fullName ?? user.username }}</h2>

                {% set roles = user.roles %}

                <span class="profile-role">
                    <i class="fas fa-shield-alt"></i>
                    {% if 'ROLE_ADMIN' in roles %}
                        Administrator
                    {% elseif 'ROLE_STAFF' in roles %}
                        Staff
                    {% else %}
                        User
                    {% endif %}
                </span>
            </div>

        </div>

        <!-- BODY -->
        <div class="profile-body">

            <div class="info-grid">

                <div class="info-item">
                    <div class="info-label">Username</div>
                    <div class="info-value">{{ user.username }}</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Email</div>
                    <div class="info-value">{{ user.email ?? 'Not set' }}</div>
                </div>

                <div class="info-item">
                    <div class="info-label">First Name</div>
                    <div class="info-value">{{ user.firstName ?? 'Not set' }}</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Last Name</div>
                    <div class="info-value">{{ user.lastName ?? 'Not set' }}</div>
                </div>

            </div>

            <!-- ACTION BUTTONS -->
            <div class="action-buttons">

                <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Edit Profile
                </a>

                <a href="{{ path('app_profile_change_password') }}" class="btn btn-secondary">
                    <i class="fas fa-key"></i> Change Password
                </a>

            </div>

        </div>
    </div>
</div>

{% endblock %}
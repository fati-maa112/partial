{% block extra_scripts %}
<script>
(function () {
    'use strict';

    /* ── Scroll Reveal ── */
    const revealEls = document.querySelectorAll('.reveal,.reveal-left,.reveal-right');
    const revealIO  = new IntersectionObserver((entries) => {
        entries.forEach(e => {
            if (e.isIntersecting) { e.target.classList.add('in-view'); revealIO.unobserve(e.target); }
        });
    }, { threshold: 0.10, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach(el => revealIO.observe(el));

    /* ── Updates filter tabs ── */
    const filterBtns  = document.querySelectorAll('.filter-btn');
    const updateCards = document.querySelectorAll('.update-card');
    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const filter = btn.dataset.filter;
            updateCards.forEach(card => {
                card.classList.toggle('hidden', filter !== 'all' && card.dataset.category !== filter);
            });
        });
    });

    /* ── Testimonials carousel ── */
    const testiTrack = document.getElementById('testiTrack');
    const testiDots  = document.querySelectorAll('.testi-ndot');
    let testiCur = 0;
    const testiTotal = 2;

    function testiGo(n) {
        testiCur = (n + testiTotal) % testiTotal;
        testiTrack.style.transform = 'translateX(-' + (testiCur * 100) + '%)';
        testiDots.forEach((d, i) => d.classList.toggle('active', i === testiCur));
    }

    document.getElementById('testiNext').addEventListener('click', () => testiGo(testiCur + 1));
    document.getElementById('testiPrev').addEventListener('click', () => testiGo(testiCur - 1));
    testiDots.forEach(d => d.addEventListener('click', () => testiGo(+d.dataset.i)));

    let testiAuto = setInterval(() => testiGo(testiCur + 1), 5500);
    document.querySelector('.testi-carousel').addEventListener('mouseenter', () => clearInterval(testiAuto));
    document.querySelector('.testi-carousel').addEventListener('mouseleave', () => {
        testiAuto = setInterval(() => testiGo(testiCur + 1), 5500);
    });

})();
</script>
{% endblock %}

   SCRIPTS
═══════════════════════════════════════════════════════ #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    'use strict';

    /* ── 1. Unified scroll-reveal ─────────────────────── */
    const allReveal = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');
    const revealIO  = new IntersectionObserver((entries) => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.classList.add('in-view');
                revealIO.unobserve(e.target);
            }
        });
    }, { threshold: 0.10, rootMargin: '0px 0px -50px 0px' });
    allReveal.forEach(el => revealIO.observe(el));

    /* ── 2. Navbar — scroll shadow + size ─────────────── */
    const nav = document.getElementById('mainNav');
    window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 60);
    }, { passive: true });

    /* ── 3. Active nav-link on scroll ─────────────────── */
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.n-nav a.n-link');
    const activeIO = new IntersectionObserver((entries) => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                navLinks.forEach(l => l.classList.remove('active'));
                const a = document.querySelector('.n-nav a[href="#' + e.target.id + '"]');
                if (a) a.classList.add('active');
            }
        });
    }, { threshold: 0.40 });
    sections.forEach(s => activeIO.observe(s));
})();
</script>


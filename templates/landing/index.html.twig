                    <i class="bi bi-star-fill" style="color:var(--taupe);font-size:0.85rem;"></i>
                    <i class="bi bi-star-fill" style="color:var(--taupe);font-size:0.85rem;"></i>
                    <i class="bi bi-star-fill" style="color:var(--taupe);font-size:0.85rem;"></i>
                    <i class="bi bi-star-fill" style="color:var(--taupe);font-size:0.85rem;"></i>

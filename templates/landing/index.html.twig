                            <span class="author-name">Mel Ramirez</span>
                            <div class="author-byline"><span>May 2026</span><span class="byline-dot"></span><span>4 min read</span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="update-card reveal d4" data-category="body">

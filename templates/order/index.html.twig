{% extends 'base.html.twig' %}

{% block title %}Activity Logs - Naturae Admin{% endblock %}
{% block page_title %}Activity Logs{% endblock %}

{% block stylesheets %}
<style>
    .logs-container {
        background: var(--color-white);
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        position: relative;
        overflow: hidden;
    }

    [data-theme="dark"] .logs-container {
        background: var(--color-white);
    }

    .logs-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .logs-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--color-olive);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .logs-title i {
        font-size: 28px;
        color: var(--color-sand);
    }

    /* Live badge */
    .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(122, 134, 97, 0.08);
        border: 1px solid rgba(122, 134, 97, 0.25);
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 12px;
        color: var(--color-olive);
        font-weight: 600;
        margin-top: 6px;
    }

    .live-dot {
        width: 8px;
        height: 8px;
        background: #4caf50;
        border-radius: 50%;
        animation: pulse-dot 2s ease-in-out infinite;
    }

    @keyframes pulse-dot {
        0%, 100% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.5); }
        50%       { box-shadow: 0 0 0 5px rgba(76, 175, 80, 0); }
    }

    .logs-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: linear-gradient(135deg, var(--color-cream) 0%, rgba(255, 255, 255, 0.5) 100%);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

    [data-theme="dark"] .stat-card {
        background: linear-gradient(135deg, #3a3a3a 0%, rgba(47, 47, 47, 0.5) 100%);
    }

    .stat-card:hover {
        border-color: var(--color-olive-light);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(122, 134, 97, 0.15);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .stat-icon.create  { background: rgba(76, 175, 80, 0.1);  color: #4caf50; }
    .stat-icon.update  { background: rgba(33, 150, 243, 0.1); color: #2196f3; }
    .stat-icon.delete  { background: rgba(244, 67, 54, 0.1);  color: #f44336; }
    .stat-icon.login   { background: rgba(156, 39, 176, 0.1); color: #9c27b0; }
    .stat-icon.logout  { background: rgba(255, 152, 0, 0.1);  color: #ff9800; }

    .stat-info { flex: 1; }

    .stat-label {
        font-size: 13px;
        color: #666;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--color-text);
        transition: transform 0.2s ease;
    }

    .stat-value.bump {
        transform: scale(1.3);
    }

    .filters-section {
        background: var(--color-cream);
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        border: 2px solid rgba(122, 134, 97, 0.1);
    }

    [data-theme="dark"] .filters-section {
        background: #2f2f2f;
        border-color: rgba(155, 168, 130, 0.2);
    }

    .filters-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--color-olive);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-group label {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .filter-group input,
    .filter-group select {
        padding: 12px 16px;
        border: 2px solid rgba(122, 134, 97, 0.2);
        border-radius: 10px;
        background: var(--color-white);
        color: var(--color-text);
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s ease;
        outline: none;
    }

    [data-theme="dark"] .filter-group input,
    [data-theme="dark"] .filter-group select {
        background: #3a3a3a;
        border-color: rgba(155, 168, 130, 0.3);
    }

    .filter-group input:focus,
    .filter-group select:focus {
        border-color: var(--color-olive);
        box-shadow: 0 0 0 3px rgba(122, 134, 97, 0.1);
    }

    .filters-actions {
        display: flex;
        gap: 12px;
        margin-top: 20px;
        justify-content: flex-end;
    }

    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--color-olive) 0%, var(--color-olive-light) 100%);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(122, 134, 97, 0.3);
    }

    .btn-secondary {
        background: var(--color-cream);
        color: var(--color-text);
        border: 2px solid rgba(122, 134, 97, 0.2);
    }

    [data-theme="dark"] .btn-secondary {
        background: #3a3a3a;
        border-color: rgba(155, 168, 130, 0.3);
    }

    .btn-secondary:hover {
        background: var(--color-white);
        border-color: var(--color-olive);
    }

    .logs-table-container {
        overflow-x: auto;
        border-radius: 12px;
        border: 2px solid rgba(122, 134, 97, 0.1);
    }

    .logs-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--color-white);
    }

    [data-theme="dark"] .logs-table {
        background: var(--color-white);
    }

    .logs-table thead {
        background: linear-gradient(135deg, var(--color-olive) 0%, var(--color-olive-dark) 100%);
    }

    .logs-table thead th {
        padding: 18px 20px;
        text-align: left;
        font-size: 13px;
        font-weight: 700;
        color: white;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .logs-table tbody tr {
        border-bottom: 1px solid rgba(122, 134, 97, 0.1);
        transition: all 0.2s ease;
    }

    [data-theme="dark"] .logs-table tbody tr {
        border-bottom: 1px solid rgba(155, 168, 130, 0.2);
    }

    .logs-table tbody tr:hover {
        background: var(--color-cream);
    }

    [data-theme="dark"] .logs-table tbody tr:hover {
        background: #2f2f2f;
    }

    .logs-table tbody td {
        padding: 16px 20px;
        font-size: 14px;
        color: var(--color-text);
    }

    .action-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .action-badge.create { background: rgba(76, 175, 80, 0.1);  color: #4caf50; }
    .action-badge.update { background: rgba(33, 150, 243, 0.1); color: #2196f3; }
    .action-badge.delete { background: rgba(244, 67, 54, 0.1);  color: #f44336; }
    .action-badge.login  { background: rgba(156, 39, 176, 0.1); color: #9c27b0; }
    .action-badge.logout { background: rgba(255, 152, 0, 0.1);  color: #ff9800; }

    .role-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        background: rgba(122, 134, 97, 0.1);
        color: var(--color-olive);
    }

    .view-btn {
        padding: 8px 16px;
        background: var(--color-olive);
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .view-btn:hover {
        background: var(--color-olive-dark);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(122, 134, 97, 0.3);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }

    .empty-state i {
        font-size: 64px;
        margin-bottom: 20px;
        opacity: 0.3;
    }

    .empty-state p {
        font-size: 16px;
        font-weight: 500;
    }

    /* Real-time new row highlight */
    @keyframes highlightNew {
        0%   { background: rgba(122, 134, 97, 0.18); }
        100% { background: transparent; }
    }

    .log-row-new {
        animation: highlightNew 2.5s ease forwards;
    }

    /* Toast notification */
    #log-toast {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 9999;
        background: #1a2e1a;
        color: #e8f0e8;
        border-left: 4px solid #7a8661;
        border-radius: 12px;
        padding: 14px 18px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.25);
        min-width: 280px;
        max-width: 400px;
        transform: translateX(120%);
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        pointer-events: none;
    }

    #log-toast.show {
        transform: translateX(0);
        pointer-events: auto;
    }

    .toast-icon  { font-size: 20px; flex-shrink: 0; margin-top: 2px; }
    .toast-body strong {
        display: block;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 2px;
        color: #c8e6c9;
    }
    .toast-body span { font-size: 12px; color: #a5c8a5; }
    .toast-close {
        margin-left: auto;
        background: none;
        border: none;
        color: #8aab8a;
        font-size: 16px;
        cursor: pointer;
        padding: 0 0 0 8px;
        flex-shrink: 0;
    }
    .toast-close:hover { color: #e8f0e8; }

    @media (max-width: 768px) {
        .logs-stats        { grid-template-columns: 1fr; }
        .filters-grid      { grid-template-columns: 1fr; }
        .logs-table-container { overflow-x: scroll; }
        .logs-table        { min-width: 800px; }
    }
</style>
{% endblock %}

{% block body %}

{# ── Toast ── #}
<div id="log-toast">
    <div class="toast-icon">📋</div>
    <div class="toast-body">
        <strong id="toast-title">New Activity</strong>
        <span id="toast-body">Loading…</span>
    </div>
    <button class="toast-close" onclick="hideToast()" aria-label="Close">✕</button>
</div>

<div class="logs-container">
    <div class="logs-header">
        <div>
            <div class="logs-title">
                <i class="fas fa-clipboard-list"></i>
                System Activity Logs
            </div>
            <div class="live-badge">
                <span class="live-dot"></span>
                <span id="socket-status">Connecting…</span>
            </div>
        </div>
    </div>

    {# ── Stats ── #}
    <div class="logs-stats">
        <div class="stat-card">
            <div class="stat-icon create"><i class="fas fa-plus-circle"></i></div>
            <div class="stat-info">
                <div class="stat-label">Create</div>
                <div class="stat-value" data-action="CREATE">{{ actionCounts.CREATE ?? 0 }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon update"><i class="fas fa-edit"></i></div>
            <div class="stat-info">
                <div class="stat-label">Update</div>
                <div class="stat-value" data-action="UPDATE">{{ actionCounts.UPDATE ?? 0 }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon delete"><i class="fas fa-trash-alt"></i></div>
            <div class="stat-info">
                <div class="stat-label">Delete</div>
                <div class="stat-value" data-action="DELETE">{{ actionCounts.DELETE ?? 0 }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon login"><i class="fas fa-sign-in-alt"></i></div>
            <div class="stat-info">
                <div class="stat-label">Login</div>
                <div class="stat-value" data-action="LOGIN">{{ actionCounts.LOGIN ?? 0 }}</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon logout"><i class="fas fa-sign-out-alt"></i></div>
            <div class="stat-info">
                <div class="stat-label">Logout</div>
                <div class="stat-value" data-action="LOGOUT">{{ actionCounts.LOGOUT ?? 0 }}</div>
            </div>
        </div>
    </div>

    {# ── Filters ── #}
    <div class="filters-section">
        <div class="filters-title">
            <i class="fas fa-filter"></i>
            Filter Logs
        </div>
        <form method="GET" action="{{ path('app_activity_logs') }}">
            <div class="filters-grid">
                <div class="filter-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username"
                           placeholder="Search by username"
                           value="{{ filters.username }}">
                </div>
                <div class="filter-group">
                    <label for="action">Action</label>
                    <select id="action" name="action">
                        <option value="">All Actions</option>
                        <option value="CREATE" {{ filters.action == 'CREATE' ? 'selected' : '' }}>Create</option>
                        <option value="UPDATE" {{ filters.action == 'UPDATE' ? 'selected' : '' }}>Update</option>
                        <option value="DELETE" {{ filters.action == 'DELETE' ? 'selected' : '' }}>Delete</option>
                        <option value="LOGIN"  {{ filters.action == 'LOGIN'  ? 'selected' : '' }}>Login</option>
                        <option value="LOGOUT" {{ filters.action == 'LOGOUT' ? 'selected' : '' }}>Logout</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="date_from">Date From</label>
                    <input type="date" id="date_from" name="date_from" value="{{ filters.date_from }}">
                </div>
                <div class="filter-group">
                    <label for="date_to">Date To</label>
                    <input type="date" id="date_to" name="date_to" value="{{ filters.date_to }}">
                </div>
            </div>
            <div class="filters-actions">
                <a href="{{ path('app_activity_logs') }}" class="btn btn-secondary">
                    <i class="fas fa-undo"></i> Reset
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Apply Filters
                </button>
            </div>
        </form>
    </div>

    {# ── Table ── #}
    <div class="logs-table-container">
        {% if logs is empty %}
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <p>No activity logs found</p>
            </div>
        {% else %}
            <table class="logs-table" id="logs-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Description</th>
                        <th>Date &amp; Time</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="logs-tbody">
                    {% for log in logs %}
                    <tr>
                        <td><strong>#{{ log.id }}</strong></td>
                        <td>{{ log.username }}</td>
                        <td><span class="role-badge">{{ log.role }}</span></td>
                        <td>
                            <span class="action-badge {{ log.action|lower }}">
                                {{ log.action }}
                            </span>
                        </td>
                        <td>{{ log.targetData|length > 60 ? log.targetData|slice(0, 60) ~ '…' : log.targetData }}</td>
                        <td>{{ log.createdAt|date('M d, Y h:i A') }}</td>
                        <td>
                            <a href="{{ path('app_activity_log_show', {id: log.id}) }}" class="view-btn">
                                <i class="fas fa-eye"></i> View
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {# ── Pagination ── #}
    {% if pagination.total > 1 %}
    <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-top:24px; flex-wrap:wrap;">
        {% if pagination.current > 1 %}
            <a href="{{ path('app_activity_logs', filters|merge({page: pagination.current - 1})) }}"
               class="btn btn-secondary" style="padding:8px 16px;">
                <i class="fas fa-chevron-left"></i> Prev
            </a>
        {% endif %}

        {% for p in 1..pagination.total %}
            {% if p == pagination.current %}
                <span class="btn btn-primary" style="padding:8px 14px; cursor:default;">{{ p }}</span>
            {% elseif p == 1 or p == pagination.total or (p >= pagination.current - 2 and p <= pagination.current + 2) %}
                <a href="{{ path('app_activity_logs', filters|merge({page: p})) }}"
                   class="btn btn-secondary" style="padding:8px 14px;">{{ p }}</a>
            {% elseif p == pagination.current - 3 or p == pagination.current + 3 %}
                <span style="padding:0 4px; color:#999;">…</span>
            {% endif %}
        {% endfor %}

        {% if pagination.current < pagination.total %}
            <a href="{{ path('app_activity_logs', filters|merge({page: pagination.current + 1})) }}"
               class="btn btn-secondary" style="padding:8px 16px;">
                Next <i class="fas fa-chevron-right"></i>
            </a>
        {% endif %}
    </div>
    <p style="text-align:center; margin-top:10px; font-size:13px; color:#999;">
        Showing page {{ pagination.current }} of {{ pagination.total }}
        ({{ pagination.totalLogs }} total logs)
    </p>
    {% endif %}

</div>

{# ── Socket.IO real-time updates ── #}
<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<script>
// ── Toast helpers ─────────────────────────────────────────────────────────────
let toastTimer = null;

function showToast(title, body) {
    document.getElementById('toast-title').textContent = title;
    document.getElementById('toast-body').textContent  = body;
    const toast = document.getElementById('log-toast');
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(hideToast, 5000);
}

function hideToast() {
    document.getElementById('log-toast').classList.remove('show');
}

// ── Stat bump animation ───────────────────────────────────────────────────────
function bumpStat(action) {
    const el = document.querySelector(`.stat-value[data-action="${action.toUpperCase()}"]`);
    if (!el) return;
    el.textContent = (parseInt(el.textContent, 10) || 0) + 1;
    el.classList.remove('bump');
    void el.offsetWidth; // reflow to restart animation
    el.classList.add('bump');
    setTimeout(() => el.classList.remove('bump'), 300);
}

// ── Action badge HTML helper ──────────────────────────────────────────────────
function actionBadge(action) {
    const a = (action || '').toLowerCase();
    const icons = {
        create: 'fa-plus-circle',
        update: 'fa-edit',
        delete: 'fa-trash-alt',
        login:  'fa-sign-in-alt',
        logout: 'fa-sign-out-alt',
    };
    const icon = icons[a] || 'fa-circle';
    return `<span class="action-badge ${a}"><i class="fas ${icon}"></i> ${action.toUpperCase()}</span>`;
}

// ── Socket.IO connection ──────────────────────────────────────────────────────
const socket = io('https://naturae-socket-production.up.railway.app', {
    transports: ['websocket', 'polling'],
    reconnection: true,
    reconnectionAttempts: 10,
    reconnectionDelay: 2000,
});

socket.on('connect', () => {
    console.log('[ActivityLog] Socket connected ✅', socket.id);
    document.getElementById('socket-status').textContent = 'Live Updates Active';
    socket.emit('join-admin', { role: 'admin' });
});

socket.on('disconnect', (reason) => {
    console.warn('[ActivityLog] Disconnected:', reason);
    document.getElementById('socket-status').textContent = 'Reconnecting…';
});

socket.on('reconnect', () => {
    document.getElementById('socket-status').textContent = 'Live Updates Active';
    socket.emit('join-admin', { role: 'admin' });
});

// ── New activity log received ─────────────────────────────────────────────────
socket.on('activity_logged', (data) => {
    console.log('[ActivityLog] New activity:', data);

    const tbody = document.getElementById('logs-tbody');
    if (!tbody) return;

    const desc = (data.description || '').length > 60
        ? data.description.slice(0, 60) + '…'
        : (data.description || '');

    const row = document.createElement('tr');
    row.classList.add('log-row-new');
    row.innerHTML = `
        <td><strong>#${data.id}</strong></td>
        <td>${data.username}</td>
        <td><span class="role-badge">${data.role}</span></td>
        <td>${actionBadge(data.action)}</td>
        <td>${desc}</td>
        <td>${data.createdAt}</td>
        <td>
            <a href="/activity-logs/${data.id}" class="view-btn">
                <i class="fas fa-eye"></i> View
            </a>
        </td>`;

    // Prepend so the newest log is always at the top
    tbody.insertBefore(row, tbody.firstChild);

    // Remove the empty-state div if it exists
    const emptyState = document.querySelector('.empty-state');
    if (emptyState) emptyState.remove();

    // Bump the matching stat counter
    bumpStat(data.action);

    // Show toast
    const actionLabels = {
        CREATE: '✅ New record created',
        UPDATE: '✏️ Record updated',
        DELETE: '🗑️ Record deleted',
        LOGIN:  '🔐 User logged in',
        LOGOUT: '🚪 User logged out',
    };
    showToast(
        actionLabels[data.action.toUpperCase()] || '📋 New Activity',
        `${data.username} (${data.role}) — ${desc}`
    );
});
</script>
{% endblock %}

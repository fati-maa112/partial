{% extends 'base.html.twig' %}

{% block title %}Create New Order{% endblock %}
{% block page_title %}New Order{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e8ebe9 100%);
        font-family: 'Poppins', sans-serif;
        color: #333;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .page-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    .page-header {
        background: linear-gradient(135deg, #6B7755 0%, #556042 100%);
        padding: 30px 40px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(107, 119, 85, 0.2);
        text-align: center;
    }

    .page-header h1 {
        color: #fff;
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 8px 0;
        letter-spacing: -0.5px;
    }

    .page-header p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 15px;
        margin: 0;
    }

    .form-container {
        background: #fff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    .info-box {
        background: linear-gradient(135deg, #dbeafe, #e0f2fe);
        border: 2px solid #60a5fa;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .info-box i {
        color: #2563eb;
        font-size: 20px;
        margin-top: 2px;
    }

    .info-box-content {
        flex: 1;
    }

    .info-box-content strong {
        display: block;
        color: #1e40af;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .info-box-content p {
        color: #1e3a8a;
        font-size: 13px;
        margin: 0;
        line-height: 1.5;
    }

    .form-row {
        margin-bottom: 24px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .form-grid-full {
        grid-column: 1 / -1;
    }

    label {
        display: block;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #374151;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    label.required:after {
        content: " *";
        color: #ef4444;
    }

    input[type="text"],
    input[type="number"],
    textarea,
    select {
        width: 100%;
        padding: 14px 16px;
        border-radius: 12px;
        border: 2px solid #e5e7eb;
        background: #f9fafb;
        font-size: 15px;
        transition: all 0.3s ease;
        font-family: 'Poppins', sans-serif;
    }

    input[type="text"]:focus,
    input[type="number"]:focus,
    textarea:focus,
    select:focus {
        border-color: #6B7755;
        outline: none;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(107, 119, 85, 0.1);
    }

    .form-actions {
        display: flex;
        gap: 16px;
        margin-top: 32px;
    }

    .btn {
        flex: 1;
        padding: 16px 24px;
        border-radius: 12px;
        border: none;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6B7755, #556042);
        color: #fff;
        box-shadow: 0 4px 12px rgba(107, 119, 85, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(107, 119, 85, 0.4);
    }

    .btn-secondary {
        background: #fff;
        color: #6B7755;
        border: 2px solid #e5e7eb;
    }

    .btn-secondary:hover {
        border-color: #6B7755;
        background: #f9fafb;
        transform: translateY(-2px);
    }

    .btn-danger {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
    }

    .btn-small {
        padding: 8px 16px;
        font-size: 12px;
        min-width: auto;
        flex: 0;
    }

    .order-item-row {
        background: #f9fafb;
        padding: 16px;
        border-radius: 12px;
        margin-bottom: 12px;
        border: 1px solid #e5e7eb;
    }

    .order-item-row label {
        margin-bottom: 8px;
        font-size: 13px;
    }

    .order-item-row input,
    .order-item-row select {
        margin-bottom: 12px;
    }

    @media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
        .form-container {
            padding: 24px;
        }
        .page-header {
            padding: 24px;
        }
        .form-actions {
            flex-direction: column-reverse;
        }
        .btn {
            width: 100%;
        }
    }

    .info-box a { color: inherit; font-weight: 700; text-decoration: underline; }
    .info-box a:hover { opacity: 0.8; }
</style>

<div class="page-wrapper">
    <div class="page-header">
        <h1><i class="fas fa-plus-circle"></i> Create New Order</h1>
        <p>Add a new order to the system</p>
    </div>

    <div class="info-box">
        <i class="fas fa-info-circle"></i>
        <div class="info-box-content">
            <strong>Quick Tip</strong>
            <p>Fill in all required fields marked with an asterisk (*). For a faster experience, use the <a href="{{ path('app_cart_view') }}">Order Cart</a> to add items and create orders.</p>
        </div>
    </div>

    <div class="form-container">
        {{ form_start(form, { 'attr': { 'id': 'order-form' } }) }}

        <div class="form-grid">
            <!-- Customer Selection -->
            <div class="form-row form-grid-full">
                {{ form_label(form.customer) }}
                {{ form_widget(form.customer) }}
                {{ form_errors(form.customer) }}
            </div>

            <!-- Order Items Collection -->
            <div class="form-row form-grid-full">
                <label class="required">Order Items</label>
                <div id="order-items-container" data-prototype="{{ form_widget(form.orderItems.vars.prototype)|e('html_attr') }}">
                    {{ form_widget(form.orderItems) }}
                </div>
                <div style="margin-top:12px;">
                    <button type="button" id="add-order-item" class="btn btn-secondary" style="padding:8px 12px;">
                        <i class="fas fa-plus"></i> Add Item
                    </button>
                </div>
            </div>

            <!-- Total Amount -->
            <div class="form-row">
                {{ form_label(form.total) }}
                {{ form_widget(form.total, { 'attr': { 'placeholder': '0.00', 'step': '0.01' } }) }}
                {{ form_errors(form.total) }}
            </div>

            <!-- Order Status -->
            <div class="form-row form-grid-full">
                {{ form_label(form.status, 'Order Status', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(form.status, { 'attr': { 'class': 'form-control' } }) }}
                {{ form_errors(form.status) }}
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
            <a href="{{ path('app_order_index') }}" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Create Order
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('order-items-container');
    const addBtn = document.getElementById('add-order-item');
    const form = document.getElementById('order-form');
    
    if (!container || !addBtn) return;

    // Get prototype from data attribute
    const prototype = container.dataset.prototype;
    let index = container.querySelectorAll('[id^="order_orderItems_"]').length || 0;

    addBtn.addEventListener('click', function (e) {
        e.preventDefault();
        
        if (!prototype) {
            console.error('Order items prototype not found');
            return;
        }
        
        // Replace __name__ with index
        let newForm = prototype.replace(/__name__/g, index);
        
        const wrapper = document.createElement('div');
        wrapper.className = 'order-item-row';
        wrapper.innerHTML = newForm;

        // Add remove button
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn btn-danger btn-small';
        removeBtn.style.marginTop = '8px';
        removeBtn.innerHTML = '<i class="fas fa-trash"></i> Remove';
        removeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            wrapper.remove();
        });

        // Mark this item for validation
        wrapper.dataset.itemIndex = index;

        wrapper.appendChild(removeBtn);
        container.appendChild(wrapper);
        index++;
    });

    // Prevent form submission if no items added
    if (form) {
        form.addEventListener('submit', function (e) {
            const itemRows = container.querySelectorAll('.order-item-row');
            if (itemRows.length === 0) {
                e.preventDefault();
                alert('Please add at least one item to the order.');
                return false;
            }
        });
    }

    // Auto-format currency input
    const totalInput = document.querySelector('input[name*="[total]"]');
    if (totalInput) {
        totalInput.addEventListener('blur', function() {
            let value = parseFloat(this.value);
            if (!isNaN(value)) {
                this.value = value.toFixed(2);
            }
        });
    }
});
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - Naturae Admin{% endblock %}
{% block page_title %}Category Details{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --color-olive: #6B7755;
        --color-olive-dark: #556042;
        --color-sand: #C2B280;
        --color-cream: #F5F1E8;
        --color-accent: #B55239;
    }

    /* Main Content */
    .content {
        padding: 20px 30px;
        background: #e8e5dc;
        min-height: calc(100vh - 80px);
    }

    /* Back Link */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--color-olive);
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .back-link:hover {
        color: var(--color-sand);
        gap: 12px;
    }

    /* Details Container */
    .details-container {
        max-width: 800px;
        margin: 0 auto;
    }

    /* Header Card */
    .details-header {
        background: linear-gradient(135deg, var(--color-olive) 0%, var(--color-olive-dark) 100%);
        padding: 35px 40px;
        border-radius: 16px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-left h1 {
        color: #fff;
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 8px 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .category-badge {
        display: inline-block;
        background: var(--color-sand);
        color: #fff;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .category-id {
        color: rgba(255, 255, 255, 0.8);
        font-size: 14px;
        margin: 0;
    }

    .header-right .btn-edit {
        background: #fff;
        color: var(--color-olive);
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .header-right .btn-edit:hover {
        background: var(--color-cream);
        transform: translateY(-2px);
    }

    /* Info Cards Grid */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .info-card {
        background: #fff;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .info-card h3 {
        color: var(--color-olive);
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 20px 0;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f0f0f0;
    }

    .info-row {
        display: flex;
        margin-bottom: 18px;
        align-items: flex-start;
    }

    .info-row:last-child {
        margin-bottom: 0;
    }

    .info-label {
        flex: 0 0 120px;
        font-weight: 600;
        font-size: 13px;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        flex: 1;
        font-size: 14px;
        color: #333;
        line-height: 1.6;
    }

    .info-value.empty {
        color: #999;
        font-style: italic;
    }

    /* Action Buttons */
    .action-buttons {
        background: #fff;
        padding: 25px 30px;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .btn {
        padding: 12px 28px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-edit-full {
        background: linear-gradient(135deg, var(--color-sand) 0%, #a9986c 100%);
        color: #fff;
    }

    .btn-edit-full:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(194, 178, 128, 0.3);
    }

    .btn-delete {
        background: linear-gradient(135deg, var(--color-accent) 0%, #8f3f2d 100%);
        color: #fff;
    }

    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(181, 82, 57, 0.3);
    }

    /* Description Box */
    .description-box {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        border-left: 4px solid var(--color-sand);
    }

    .description-box p {
        margin: 0;
        color: #555;
        line-height: 1.8;
    }
</style>

<div class="content">
    <a href="{{ path('app_category_index') }}" class="back-link">
        <i class="fas fa-arrow-left"></i> Back to Categories
    </a>

    <div class="details-container">
        <!-- Header -->
        <div class="details-header">
            <div class="header-left">
                <h1>
                    {{ category.name }}
                    <span class="category-badge">
                        <i class="fas fa-tag"></i> mask
                    </span>
                </h1>
                <p class="category-id">Category ID: #{{ category.id }}</p>
            </div>
            <div class="header-right">
                <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn-edit">
                    <i class="fas fa-edit"></i> Edit
                </a>
            </div>
        </div>

        <!-- Info Grid -->
        <div class="info-grid">
            <!-- Basic Information -->
            <div class="info-card">
                <h3>
                    <i class="fas fa-info-circle"></i>
                    Basic Information
                </h3>
                <div class="info-row">
                    <div class="info-label">ID</div>
                    <div class="info-value">#{{ category.id }}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Name</div>
                    <div class="info-value">{{ category.name }}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Status</div>
                    <div class="info-value">
                        <span style="background: #e8f5e9; color: #4caf50; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                            <i class="fas fa-check-circle"></i> Active
                        </span>
                    </div>
                </div>
            </div>

            <!-- Statistics -->
            <div class="info-card">
                <h3>
                    <i class="fas fa-chart-bar"></i>
                    Statistics
                </h3>
                <div class="info-row">
                    <div class="info-label">Products</div>
                    <div class="info-value">
                        <strong style="color: var(--color-olive); font-size: 18px;">0</strong> products in this category
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">Created</div>
                    <div class="info-value">
                        <i class="far fa-calendar-alt" style="color: var(--color-sand); margin-right: 5px;"></i>
                        Just now
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-label">Modified</div>
                    <div class="info-value">
                        <i class="far fa-clock" style="color: var(--color-sand); margin-right: 5px;"></i>
                        Never
                    </div>
                </div>
            </div>
        </div>

        <!-- Description -->
        <div class="info-card">
            <h3>
                <i class="fas fa-align-left"></i>
                Category Description
            </h3>
            {% if category.description %}
                <div class="description-box">
                    <p>{{ category.description }}</p>
                </div>
            {% else %}
                <p class="info-value empty">
                    <i class="fas fa-info-circle"></i> No description provided for this category
                </p>
            {% endif %}
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-edit-full">
                <i class="fas fa-edit"></i> Edit Category
            </a>
            <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" onsubmit="return confirm('⚠️ Are you sure you want to delete this category?\n\nThis action cannot be undone!');" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                <button type="submit" class="btn btn-delete">
                    <i class="fas fa-trash-alt"></i> Delete Category
                </button>
            </form>
        </div>
    </div>
</div>

{% endblock %}
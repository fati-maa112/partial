{% extends 'base.html.twig' %}

{% block title %}Customer Details - Naturae Admin{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --color-olive: #6B7755;
        --color-olive-dark: #556042;
        --color-sand: #C2B280;
        --color-cream: #F5F1E8;
        --color-accent: #B55239;
    }

    /* Main Content */
    .content {
        padding: 20px 30px;
        background: #e8e5dc;
        min-height: calc(100vh - 80px);
    }

    /* Breadcrumb */
    .breadcrumb {
        background: transparent;
        padding: 0;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #666;
    }

    .breadcrumb a {
        color: var(--color-olive);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .breadcrumb a:hover {
        color: var(--color-olive-dark);
    }

    .breadcrumb i {
        font-size: 12px;
        color: #999;
    }

    /* Action Bar */
    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .action-buttons {
        display: flex;
        gap: 12px;
    }

    .btn {
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        border: none;
    }

    .btn-back {
        background: #fff;
        color: #666;
        border: 2px solid #e0e0e0;
    }

    .btn-back:hover {
        background: #f9f9f9;
        border-color: #ccc;
    }

    .btn-edit {
        background: var(--color-sand);
        color: #fff;
        box-shadow: 0 2px 8px rgba(194, 178, 128, 0.3);
    }

    .btn-edit:hover {
        background: #a9986c;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(194, 178, 128, 0.4);
    }

    .btn-delete {
        background: var(--color-accent);
        color: #fff;
        box-shadow: 0 2px 8px rgba(181, 82, 57, 0.3);
    }

    .btn-delete:hover {
        background: #8f3f2d;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(181, 82, 57, 0.4);
    }

    /* Profile Header */
    .profile-header {
        background: linear-gradient(135deg, var(--color-olive) 0%, var(--color-olive-dark) 100%);
        padding: 40px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        gap: 30px;
    }

    .customer-avatar-large {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: #fff;
        color: var(--color-olive);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 48px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        flex-shrink: 0;
    }

    .profile-info {
        flex: 1;
    }

    .profile-info h1 {
        color: #fff;
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 10px 0;
    }

    .profile-meta {
        display: flex;
        gap: 30px;
        margin-top: 15px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: rgba(255, 255, 255, 0.9);
        font-size: 14px;
    }

    .meta-item i {
        color: var(--color-sand);
        font-size: 16px;
    }

    /* Status Badge */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 16px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
    }

    /* Content Grid */
    .content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 25px;
        margin-bottom: 25px;
    }

    /* Info Card */
    .info-card {
        background: #fff;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .card-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--color-olive);
        margin: 0 0 25px 0;
        padding-bottom: 15px;
        border-bottom: 2px solid #f0f0f0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-title i {
        font-size: 22px;
        color: var(--color-sand);
    }

    /* Info Row */
    .info-row {
        display: grid;
        grid-template-columns: 140px 1fr;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid #f5f5f5;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        font-size: 13px;
        font-weight: 600;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-label i {
        color: var(--color-sand);
        font-size: 14px;
    }

    .info-value {
        font-size: 15px;
        color: #333;
        font-weight: 500;
    }

    .info-value.empty {
        color: #999;
        font-style: italic;
    }

    /* Stats Card */
    .stats-card {
        background: #fff;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .stat-item {
        text-align: center;
        padding: 20px;
        background: linear-gradient(135deg, #f9f9f9, #f0f0f0);
        border-radius: 12px;
        margin-bottom: 15px;
    }

    .stat-item:last-child {
        margin-bottom: 0;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 10px;
        background: var(--color-sand);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 24px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--color-olive);
        margin-bottom: 5px;
    }

    .stat-label {
        font-size: 12px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    /* Timeline */
    .timeline {
        margin-top: 20px;
    }

    .timeline-item {
        display: flex;
        gap: 15px;
        padding: 15px;
        background: #f9f9f9;
        border-radius: 8px;
        margin-bottom: 10px;
    }

    .timeline-icon {
        width: 40px;
        height: 40px;
        background: var(--color-olive);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 16px;
        flex-shrink: 0;
    }

    .timeline-content h4 {
        font-size: 14px;
        font-weight: 600;
        color: #333;
        margin: 0 0 5px 0;
    }

    .timeline-content p {
        font-size: 13px;
        color: #888;
        margin: 0;
    }

    /* Responsive */
    @media (max-width: 968px) {
        .content-grid {
            grid-template-columns: 1fr;
        }

        .profile-header {
            flex-direction: column;
            text-align: center;
        }

        .profile-meta {
            flex-direction: column;
            gap: 10px;
        }

        .action-buttons {
            flex-direction: column;
            width: 100%;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="content">
    <!-- Breadcrumb -->
    <div class="breadcrumb">
        <a href="{{ path('app_customer_index') }}"><i class="fas fa-users"></i> Customers</a>
        <i class="fas fa-chevron-right"></i>
        <span>{{ customer.FullName }}</span>
    </div>

    <!-- Action Bar -->
    <div class="action-bar">
        <a href="{{ path('app_customer_index') }}" class="btn btn-back">
            <i class="fas fa-arrow-left"></i>
            Back to List
        </a>
        <div class="action-buttons">
            <a href="{{ path('app_customer_edit', {'id': customer.id}) }}" class="btn btn-edit">
                <i class="fas fa-edit"></i>
                Edit Customer
            </a>
            <form method="post" action="{{ path('app_customer_delete', {'id': customer.id}) }}" onsubmit="return confirm('⚠️ Are you sure you want to delete this customer? This action cannot be undone!');" style="display: inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customer.id) }}">
                <button type="submit" class="btn btn-delete">
                    <i class="fas fa-trash-alt"></i>
                    Delete
                </button>
            </form>
        </div>
    </div>

    <!-- Profile Header -->
    <div class="profile-header">
        <div class="customer-avatar-large">
            {{ customer.FullName|slice(0, 1)|upper }}
        </div>
        <div class="profile-info">
            <h1>{{ customer.FullName }}</h1>
            <div class="status-badge">
                <i class="fas fa-check-circle"></i>
                Active Customer
            </div>
            <div class="profile-meta">
                <div class="meta-item">
                    <i class="fas fa-fingerprint"></i>
                    ID: #{{ customer.id }}
                </div>
                <div class="meta-item">
                    <i class="fas fa-calendar-alt"></i>
                    Member since {{ customer.createdAt ? customer.createdAt|date('M d, Y') : 'N/A' }}
                </div>
            </div>
        </div>
    </div>

    <!-- Content Grid -->
    <div class="content-grid">
        <!-- Customer Information -->
        <div class="info-card">
            <h2 class="card-title">
                <i class="fas fa-info-circle"></i>
                Customer Information
            </h2>

            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-user"></i>
                    Full Name
                </div>
                <div class="info-value">{{ customer.FullName }}</div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-envelope"></i>
                    Email
                </div>
                <div class="info-value {% if not customer.email %}empty{% endif %}">
                    {{ customer.email ?: 'Not provided' }}
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-phone"></i>
                    Phone
                </div>
                <div class="info-value {% if not customer.phone %}empty{% endif %}">
                    {{ customer.phone ?: 'Not provided' }}
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-map-marker-alt"></i>
                    Address
                </div>
                <div class="info-value {% if not customer.address %}empty{% endif %}">
                    {{ customer.address ?: 'Not provided' }}
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-calendar-plus"></i>
                    Created At
                </div>
                <div class="info-value">
                    {{ customer.createdAt ? customer.createdAt|date('F d, Y - h:i A') : 'N/A' }}
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="stats-card">
            <h2 class="card-title">
                <i class="fas fa-chart-bar"></i>
                Quick Stats
            </h2>

            <div class="stat-item">
                <div class="stat-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="stat-value">0</div>
                <div class="stat-label">Total Orders</div>
            </div>

            <div class="stat-item">
                <div class="stat-icon" style="background: #6B7755;">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="stat-value">$0.00</div>
                <div class="stat-label">Total Spent</div>
            </div>

            <div class="stat-item">
                <div class="stat-icon" style="background: #8B9475;">
                    <i class="fas fa-star"></i>
                </div>
                <div class="stat-value">New</div>
                <div class="stat-label">Customer Status</div>
            </div>
        </div>
    </div>

    <!-- Activity Timeline -->
    <div class="info-card">
        <h2 class="card-title">
            <i class="fas fa-history"></i>
            Recent Activity
        </h2>

        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <div class="timeline-content">
                    <h4>Customer Account Created</h4>
                    <p>{{ customer.createdAt ? customer.createdAt|date('F d, Y \a\t h:i A') : 'Date not available' }}</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-icon" style="background: #999;">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div class="timeline-content">
                    <h4>No Activity Yet</h4>
                    <p>This customer hasn't placed any orders yet.</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}